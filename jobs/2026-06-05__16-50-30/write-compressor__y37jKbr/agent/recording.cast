[235.894988, "i", "python3 << 'PYEOF'\nclass ArithmeticEncoder:\n    def __init__(self):\n        self.radix = 255\n        self.range = 1\n        self.fraction = 0\n        self.output = bytearray()\n        self.cc = [0] * (2000000)  # Larger array\n    \n    def put_bit(self, bit, ctx):\n        # Mirror of get_bit in decompressor\n        counts_idx = ctx * 2\n        \n        # Initialize if needed\n        if self.cc[counts_idx] == 0:\n            self.cc[counts_idx] = 1\n        if self.cc[counts_idx + 1] == 0:\n            self.cc[counts_idx + 1] = 1\n        \n        count0 = self.cc[counts_idx]\n        count1 = self.cc[counts_idx + 1]\n        \n        # Calculate split point\n        split = self.range * (count0 + 1) // (count0 + count1 + 2)\n        \n        if bit:\n            self.fraction += split\n            self.range -= split\n        else:\n            self.range = split\n        \n        # Update counts\n        if bit:\n            self.cc[counts_idx + 1] += 1\n        else:\n            self.cc[counts_idx] += 1\n        \n        # Output bytes when range is small\n        while self.range < self.radix:\n            self.range *= self.radix\n            byte_val = (self.fraction // self.range) + 1\n            byte_val = min(255, max(1, byte_val))\n            self.output.append(byte_val)\n            self.fraction = (self.fraction % self.range) * self.radix\n    \n    def put_integer(self, value, bits, ctx):\n        # Encode integer using get_integer format\n        target = value + (1 << bits)\n        bit_length = target.bit_length()\n        \n        # Write unary: bit_length ones then a zero\n        for i in range(bit_length):\n            self.put_bit(1, ctx + i)\n        self.put_bit(0, ctx + bit_length)\n        \n        # Write bit_length-1 bits of target (without leading 1)\n        for i in range(bit_length - 2, -1, -1):\n            self.put_bit((target >> i) & 1, ctx + bit_length + 1 + (bit_length - 2 - i))\n    \n    def finish(self):\n        # Flush remaining fraction\n        for _ in range(10):\n            byte_val = (self.fraction // self.range) + 1\n            byte_val = min(255, max(1, byte_val))\n            self.output.append(byte_val)\n            self.fraction = (self.fraction % self.range) * self.radix\n            self.range *= self.radix\n        return bytes(self.output)\n\ndata = open('data.txt', 'rb').read()\nencoder = ArithmeticEncoder()\n\n# Encode length\nencoder.put_integer(len(data), 9, 0)\n\nprint(f\"After length, output size: {len(encoder.output)}\")\n\n# Encode data\nfor i, byte_val in enumerate(data):\n    # Control bit: 0 = literal\n    encoder.put_bit(0, 1)\n    \n    # For literal: (1-2*sign_bit) * magnitude = byte_val\n    # So if byte_val >= 0: sign_bit = 0, magnitude = byte_val\n    # If byte_val < 0: sign_bit = 1, magnitude = -byte_val\n    \n    if byte_val >= 0:\n        encoder.put_bit(0, 8)  # sign bit = 0\n        magnitude = byte_val\n    else:\n        encoder.put_bit(1, 8)  # sign bit = 1\n        magnitude = -byte_val\n    \n    # Now encode magnitude using get_integer(LITSIZE=4, ctx=9)\n    encoder.put_integer(magnitude, 4, 9)\n    \n    if i % 500 == 0:\n        print(f\"Encoded {i} bytes, output: {len(encoder.output)}\")\n\ncompressed = encoder.finish()\nprint(f\"Final compressed size: {len(compressed)}\")\n\nwith open('data.comp', 'wb') as f:\n    f.write(compressed)\nPYEOF\n"]
