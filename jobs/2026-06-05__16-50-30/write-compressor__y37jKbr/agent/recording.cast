[235.899078, "o", "        if bit:\r\n\u001b[?2004l\r\u001b[?2004h>             self.fraction += split\r\n\u001b[?2004l\r\u001b[?2004h>             self.range -= split\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             self.range = split\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         # Update counts\r\n\u001b[?2004l\r\u001b[?2004h>         if bit:\r\n\u001b[?2004l\r\u001b[?2004h>             self.cc[counts_idx + 1] += 1\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             self.cc[counts_idx] += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.899142, "o", "        \r\n\u001b[?2004l\r"]
[235.899385, "o", "\u001b[?2004h>         # Output bytes when range is small\r\n\u001b[?2004l\r\u001b[?2004h>         while self.range < self.radix:\r\n\u001b[?2004l\r"]
[235.899497, "o", "\u001b[?2004h> "]
[235.899683, "o", "            self.range *= self.radix\r\n\u001b[?2004l\r"]
[235.899931, "o", "\u001b[?2004h>             byte_val = (self.fraction // self.range) + 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
