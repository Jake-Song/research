[259.257803, "o", "data = open('data.txt', 'rb').read()\r\n\u001b[?2004l\r\u001b[?2004h> encoder = ArithmeticEncoder()\r\n\u001b[?2004l\r"]
[259.257863, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.258462, "o", "encoder.put_integer(len(data), 9, 0)\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"After length: {len(encoder.output)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> pos = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.258535, "o", "max_dist = (1 << 5) - 1  # OFF1 = 5 bits, so max distance = 31\r\n\u001b[?2004l\r"]
[259.258846, "o", "\u001b[?2004h> max_backref_len = (1 << 2)  # OFF2 = 2 bits, gives 0-3, then +1, so 1-4\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.258945, "o", "while pos < len(data):\r\n\u001b[?2004l\r\u001b[?2004h>     # Try to find a match\r\n\u001b[?2004l\r"]
[259.259023, "o", "\u001b[?2004h> "]
[259.259237, "o", "    match_len, match_dist = find_best_match(data, pos, max_dist, max_backref_len + 1)\r\n\u001b[?2004l\r"]
[259.259378, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.259432, "o", "    # Only use backreference if it's worth it\r\n\u001b[?2004l\r"]
[259.259503, "o", "\u001b[?2004h> "]
[259.259565, "o", "    if match_len >= 2:\r\n\u001b[?2004l\r"]
[259.259696, "o", "\u001b[?2004h>         # Use backreference\r\n\u001b[?2004l\r\u001b[?2004h"]
[259.259748, "o", "> "]
[259.259846, "o", "        encoder.put_bit(1, 1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[259.259922, "o", "> "]
[259.260052, "o", "        encoder.put_integer(match_dist, 5, 2)  # OFF1 = 5\r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.260266, "o", "        encoder.put_integer(match_len - 1, 2, 3)  # OFF2 = 2, then +1\r\n\u001b[?2004l\r\u001b[?2004h"]
[259.260347, "o", "> "]
[259.260401, "o", "        pos += match_len\r\n\u001b[?2004l\r\u001b[?2004h> "]
[259.260485, "o", "    else:\r\n\u001b[?2004l\r"]
[259.260534, "o", "\u001b[?2004h> "]
[259.260617, "o", "        # Use literal\r\n\u001b[?2004l\r"]
[259.260678, "o", "\u001b[?2004h> "]
[259.260727, "o", "        encoder.put_bit(0, 1)\r\n\u001b[?2004l\r"]
[259.26369, "o", "\u001b[?2004h> "]
[259.263953, "o", "        byte_val = data[pos]\r\n\u001b[?2004l\r\u001b[?2004h>         if byte_val >= 0:\r\n\u001b[?2004l\r\u001b[?2004h>             encoder.put_bit(0, 8)\r\n\u001b[?2004l\r\u001b[?2004h>             magnitude = byte_val\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             encoder.put_bit(1, 8)\r\n\u001b[?2004l\r\u001b[?2004h>             magnitude = -byte_val\r\n\u001b[?2004l\r\u001b[?2004h>         encoder.put_integer(magnitude, 4, 9)\r\n\u001b[?2004l\r\u001b[?2004h>         pos += 1\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     if pos % 500 == 0:\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"Encoded {pos} bytes, output: {len(encoder.output)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> compressed = encoder.finish()\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Final compressed size: {len(compressed)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> with open('data.comp', 'wb') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     f.write(compressed)\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
[259.287805, "o", "After length: 5\r\n"]
[259.297458, "o", "Encoded 500 bytes, output: 536\r\n"]
[259.305695, "o", "Encoded 1000 bytes, output: 1043\r\n"]
[259.327955, "o", "Encoded 2000 bytes, output: 2074\r\n"]
[259.351021, "o", "Encoded 2500 bytes, output: 2599\r\n"]
[259.361665, "o", "Encoded 3000 bytes, output: 3121\r\n"]
[259.395887, "o", "Encoded 4500 bytes, output: 4691\r\n"]
[259.402438, "o", "Final compressed size: 5082\r\n"]
[259.428509, "o", "\u001b[?2004hroot@58d8b96be85d:/app# "]
[279.56225, "i", "python3 << 'PYEOF'\n# What range of values can get_integer(5, ctx) return?\n# subtract_it = 1 << 5 = 32\n# result starts at 1\n# After reading N bits: result = (something with N bits) = 1 to 2^N\n# Final: result - 32\n\n# With 5 bits:\n# We can encode 1 to 2^20 (or so) before result - 32\n# Actually, let's think about realistic values\n\n# If we read k ones then a zero:\n# tmp = k, then tmp-- = k-1\n# We read k-1 bits\n# result = 1, then becomes 1 to 2^(k-1) depending on bits\n# After result - 32:\n# We can get negative values (if result < 32) and positive values\n\n# For k=1: tmp after decrement = 0, read 0 bits, result = 1, final = 1-32 = -31\n# For k=2: tmp = 1, read 1 bit, result = 2 or 3, final = -30 or -29\n# ...\n# For k=6: tmp = 5, read 5 bits, result = 32 to 63, final = 0 to 31\n# For k=7: tmp = 6, read 6 bits, result = 64 to 127, final = 32 to 95\n# For k=8: tmp = 7, read 7 bits, result = 128 to 255, final = 96 to 223\n# ...\n\n# So the max distance with 5-bit encoding could be much larger!\n# Let me check what the actual max output would be\n\n# If we have a 20-bit unary code (20 ones then 0), then read 19 bits:\n# result could be up to 2^19 = 524288\n# final = 524288 - 32 = 524256\n\n# But that's unrealistic. Let me look at what makes sense for the buffer size 10000\n# With buffer[10000], max distance is ~10000\n# So values up to 10000 should be encodable\n# 10000 + 32 = 10032\n# 10032 = 0b10011100110000, needs 14 bits to represent\n# So we'd need 14 ones then a zero, then 13 bits = 28 bits total\n# That's very expensive\n\nprint(\"Max useful distance: 10000\")\nprint(f\"As get_integer value: {10000 + 32}\")\nprint(f\"Bits needed: {(10000 + 32).bit_length()}\")\n\n# Actually, I think I should allow much larger distances\n# The offset can be any value that points back into the already-written buffer\nPYEOF\n"]
