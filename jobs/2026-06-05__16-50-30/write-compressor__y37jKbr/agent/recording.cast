[302.85017, "o", "#include <stdio.h>\r\n#include <stdlib.h>\r\n#define W for (i=0;i<tmp;i++)\r\n\r\nint i;\r\nint radix = 255;\r\nint fraction;\r\nlong range = 1;\r\nint tmp;\r\nint cc[1000000];\r\n\r\nint OFF1 = 5;\r\nint OFF2 = 2;\r\nint INTOFF = 9;\r\nint LITSIZE = 4;\r\n\r\nint ll = 0;\r\n\r\nint gc() {\r\n  unsigned char c = (unsigned char)getchar();\r\n  return (int)c;\r\n}\r\n\r\nint get_bit(int ctx) {\r\n  if ( range < radix ) {\r\n    range *= radix;\r\n    fraction *= radix;\r\n\r\n    fraction += gc()-1;\r\n  }\r\n  int *counts = cc + ctx * 2;\r\n  int split = range * -~*counts / (*counts + counts[ 1 ] + 2);\r\n  int the_bit = fraction >= split;\r\n  fraction -= split*the_bit;\r\n  range = the_bit ? range-split : split;\r\n\r\n  counts[ the_bit ]++;\r\n  return the_bit;\r\n}\r\n\r\n\r\n\r\nint get_integer(int tmp, int ctx) {\r\n  int subtract_it = 1<<tmp;\r\n  int result_ans = 1;\r\n  ctx*=99;\r\n  while (!get_bit(++tmp+ctx));\r\n  tmp--;\r\n  W {\r\n    result_ans = result_ans*2 | get_bit(ctx);\r\n"]
[302.850609, "o", "\u001b[?2004h"]
[302.850829, "o", "root@58d8b96be85d:/app# "]
[313.528557, "i", "python3 << 'PYEOF'\nclass ArithmeticEncoder:\n    def __init__(self):\n        self.radix = 255\n        self.range = 1\n        self.fraction = 0\n        self.output = bytearray()\n        self.cc = [0] * (2000000)\n    \n    def put_bit(self, bit, ctx):\n        counts_idx = ctx * 2\n        if self.cc[counts_idx] == 0:\n            self.cc[counts_idx] = 1\n        if self.cc[counts_idx + 1] == 0:\n            self.cc[counts_idx + 1] = 1\n        \n        count0 = self.cc[counts_idx]\n        count1 = self.cc[counts_idx + 1]\n        split = self.range * (count0 + 1) // (count0 + count1 + 2)\n        \n        if bit:\n            self.fraction += split\n            self.range -= split\n        else:\n            self.range = split\n        \n        if bit:\n            self.cc[counts_idx + 1] += 1\n        else:\n            self.cc[counts_idx] += 1\n        \n        # Output bytes when range is small\n        while self.range < self.radix:\n            self.range *= self.radix\n            self.fraction *= self.radix\n            new_byte = (self.fraction // (self.range + 1)) + 1\n            new_byte = min(255, max(0, new_byte))\n            self.output.append(new_byte)\n            self.fraction = (self.fraction % (self.range + 1))\n    \n    def put_integer(self, value, bits, ctx):\n        # Mirrors get_integer: ctx*=99, then unary code, then value bits\n        target = value + (1 << bits)\n        bit_length = target.bit_length()\n        \n        ctx *= 99\n        \n        # Unary: write bit_length ones, then a zero\n        # while (!get_bit(++tmp+ctx));  means: increment tmp, call get_bit(tmp+ctx) until 0\n        tmp = 0\n        for i in range(bit_length):\n            tmp += 1\n            self.put_bit(1, tmp + ctx)\n        \n        # Write the 0 bit\n        tmp += 1\n        self.put_bit(0, tmp + ctx)\n        \n        # After loop: tmp-- in the C code\n        tmp -= 1\n        \n        # Now read tmp bits using get_bit(ctx)\n        for i in range(tmp - 1, -1, -1):\n            self.put_bit((target >> i) & 1, ctx)\n    \n    def finish(self):\n        # Flush\n        for _ in range(10):\n            self.range *= self.radix\n            self.fraction *= self.radix\n            new_byte = (self.fraction // (self.range + 1)) + 1\n            new_byte = min(255, max(0, new_byte))\n            self.output.append(new_byte)\n            self.fraction = (self.fraction % (self.range + 1))\n        return bytes(self.output)\n\n# Test\ntest_data = b\"Hello\"\nencoder = ArithmeticEncoder()\n\nencoder.put_integer(len(test_data), 9, 0)\nprint(f\"After length: {len(encoder.output)}\")\n\nfor byte_val in test_data:\n    encoder.put_bit(0, 1)  # literal\n    encoder.put_bit(0, 8)  # positive sign\n    encoder.put_integer(byte_val, 4, 9)  # magnitude\n\ncompressed = encoder.finish()\nprint(f\"Compressed size: {len(compressed)}\")\n\nwith open('test.comp', 'wb') as f:\n    f.write(compressed)\nPYEOF\n"]
