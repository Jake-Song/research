\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> int main() {\r\n\u001b[?2004l\r\u001b[?2004h>     // Read input\r\n\u001b[?2004l\r\u001b[?2004h>     char input[10000];\r\n\u001b[?2004l\r\u001b[?2004h>     int input_len = fread(input, 1, sizeof(input), stdin);\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     // Initialize\r\n\u001b[?2004l\r\u001b[?2004h>     memset(cc, 0, sizeof(cc));\r\n\u001b[?2004l\r\u001b[?2004h>     for (i = 0; i < 1000000; i++) {\r\n\u001b[?2004l\r\u001b[?2004h>         cc[i] = 0;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     // Encode length\r\n\u001b[?2004l\r\u001b[?2004h>     put_integer(input_len, 9, 0);\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     // Encode data (all literals for now)\r\n\u001b[?2004l\r\u001b[?2004h>     for (int j = 0; j < input_len; j++) {\r\n\u001b[?2004l\r\u001b[?2004h>         unsigned char c = input[j];\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         // Control bit: 0 = literal\r\n\u001b[?2004l\r\u001b[?2004h>         put_bit(0, 1);\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
