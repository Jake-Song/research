et = value + (1 << bits)\r\n\u001b[?2004l\r\u001b[?2004h>         bit_length = target.bit_length()\r\n\u001b[?2004l\r\u001b[?2004h>         for i in range(bit_length):\r\n\u001b[?2004l\r"]
