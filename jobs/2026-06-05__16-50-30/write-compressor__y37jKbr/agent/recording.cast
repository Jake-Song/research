[235.900216, "o", "            self.fraction = (self.fraction % self.range) * self.radix\r\n\u001b[?2004l\r"]
[235.9004, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.900601, "o", "    def put_integer(self, value, bits, ctx):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.90066, "o", "        # Encode integer using get_integer format\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.901018, "o", "        target = value + (1 << bits)\r\n\u001b[?2004l\r\u001b[?2004h>         bit_length = target.bit_length()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.901208, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.901506, "o", "        # Write unary: bit_length ones then a zero\r\n\u001b[?2004l\r\u001b[?2004h>         for i in range(bit_length):\r\n\u001b[?2004l\r"]
[235.90164, "o", "\u001b[?2004h>             self.put_bit(1, ctx + i)\r\n\u001b[?2004l\r\u001b[?2004h>         self.put_bit(0, ctx + bit_length)\r\n\u001b[?2004l\r"]
[235.901926, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.902054, "o", "        # Write bit_length-1 bits of target (without leading 1)\r\n\u001b[?2004l\r"]
[235.902306, "o", "\u001b[?2004h> "]
[235.902515, "o", "        for i in range(bit_length - 2, -1, -1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.902721, "o", "            self.put_bit((target >> i) & 1, ctx + bit_length + 1 + (bit_length - 2 - i))\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.903014, "o", "    def finish(self):\r\n\u001b[?2004l\r\u001b[?2004h>         # Flush remaining fraction\r\n\u001b[?2004l\r"]
[235.90379, "o", "\u001b[?2004h>         for _ in range(10):\r\n\u001b[?2004l\r\u001b[?2004h>             byte_val = (self.fraction // self.range) + 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.904049, "o", "            byte_val = min(255, max(1, byte_val))\r\n\u001b[?2004l\r\u001b[?2004h>             self.output.append(byte_val)\r\n\u001b[?2004l\r\u001b[?2004h>             self.fraction = (self.fraction % self.range) * self.radix\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.904297, "o", "            self.range *= self.radix\r\n\u001b[?2004l\r\u001b[?2004h>         return bytes(self.output)\r\n\u001b[?2004l\r"]
[235.904545, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> data = open('data.txt', 'rb').read()\r\n\u001b[?2004l\r\u001b[?2004h"]
[235.904833, "o", "> encoder = ArithmeticEncoder()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Encode length\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.905281, "o", "encoder.put_integer(len(data), 9, 0)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"After length, output size: {len(encoder.output)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Encode data\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.905434, "o", "for i, byte_val in enumerate(data):\r\n\u001b[?2004l\r\u001b[?2004h>     # Control bit: 0 = literal"]
[235.905578, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.905848, "o", "    encoder.put_bit(0, 1)\r\n\u001b[?2004l\r"]
[235.906063, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # For literal: (1-2*sign_bit) * magnitude = byte_val\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.906163, "o", "    # So if byte_val >= 0: sign_bit = 0, magnitude = byte_val\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.906373, "o", "    # If byte_val < 0: sign_bit = 1, magnitude = -byte_val\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.906883, "o", "    if byte_val >= 0:\r\n\u001b[?2004l\r\u001b[?2004h>         encoder.put_bit(0, 8)  # sign bit = 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[235.907123, "o", ">         magnitude = byte_val\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.907378, "o", "        encoder.put_bit(1, 8)  # sign bit = 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.907616, "o", "        magnitude = -byte_val\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.907854, "o", "    # Now encode magnitude using get_integer(LITSIZE=4, ctx=9)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.908193, "o", "    encoder.put_integer(magnitude, 4, 9)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     if i % 500 == 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.908367, "o", "        print(f\"Encoded {i} bytes, output: {len(encoder.output)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> compressed = encoder.finish()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.908602, "o", "print(f\"Final compressed size: {len(compressed)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[235.909027, "o", "with open('data.comp', 'wb') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     f.write(compressed)\r\n\u001b[?2004l\r"]
[235.909213, "o", "\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
[235.953279, "o", "After length, output size: 5\r\nEncoded 0 bytes, output: 7\r\n"]
[235.958226, "o", "Encoded 500 bytes, output: 504\r\n"]
[235.962337, "o", "Encoded 1000 bytes, output: 973\r\n"]
[235.966735, "o", "Encoded 1500 bytes, output: 1446\r\n"]
[235.971327, "o", "Encoded 2000 bytes, output: 1915\r\n"]
[235.975754, "o", "Encoded 2500 bytes, output: 2390\r\n"]
[235.982049, "o", "Encoded 3000 bytes, output: 2850\r\n"]
[235.987435, "o", "Encoded 3500 bytes, output: 3316\r\n"]
[235.991973, "o", "Encoded 4000 bytes, output: 3781\r\n"]
[235.996452, "o", "Encoded 4500 bytes, output: 4245\r\n"]
[236.001238, "o", "Final compressed size: 4600\r\n"]
[236.026516, "o", "\u001b[?2004hroot@58d8b96be85d:/app# "]
[259.238624, "i", "python3 << 'PYEOF'\nclass ArithmeticEncoder:\n    def __init__(self):\n        self.radix = 255\n        self.range = 1\n        self.fraction = 0\n        self.output = bytearray()\n        self.cc = [0] * (2000000)\n    \n    def put_bit(self, bit, ctx):\n        counts_idx = ctx * 2\n        if self.cc[counts_idx] == 0:\n            self.cc[counts_idx] = 1\n        if self.cc[counts_idx + 1] == 0:\n            self.cc[counts_idx + 1] = 1\n        \n        count0 = self.cc[counts_idx]\n        count1 = self.cc[counts_idx + 1]\n        split = self.range * (count0 + 1) // (count0 + count1 + 2)\n        \n        if bit:\n            self.fraction += split\n            self.range -= split\n        else:\n            self.range = split\n        \n        if bit:\n            self.cc[counts_idx + 1] += 1\n        else:\n            self.cc[counts_idx] += 1\n        \n        while self.range < self.radix:\n            self.range *= self.radix\n            byte_val = (self.fraction // self.range) + 1\n            byte_val = min(255, max(1, byte_val))\n            self.output.append(byte_val)\n            self.fraction = (self.fraction % self.range) * self.radix\n    \n    def put_integer(self, value, bits, ctx):\n        target = value + (1 << bits)\n        bit_length = target.bit_length()\n        for i in range(bit_length):\n            self.put_bit(1, ctx + i)\n        self.put_bit(0, ctx + bit_length)\n        for i in range(bit_length - 2, -1, -1):\n            self.put_bit((target >> i) & 1, ctx + bit_length + 1 + (bit_length - 2 - i))\n    \n    def finish(self):\n        for _ in range(10):\n            byte_val = (self.fraction // self.range) + 1\n            byte_val = min(255, max(1, byte_val))\n            self.output.append(byte_val)\n            self.fraction = (self.fraction % self.range) * self.radix\n            self.range *= self.radix\n        return bytes(self.output)\n\ndef find_best_match(data, pos, max_dist, max_len):\n    \"\"\"Find longest match in data[0:pos] for data[pos:pos+max_len]\"\"\"\n    best_len = 0\n    best_dist = 0\n    \n    search_start = max(0, pos - max_dist)\n    \n    # Look for matches\n    for i in range(search_start, pos):\n        # How many bytes match?\n        match_len = 0\n        while (match_len < max_len and \n               pos + match_len < len(data) and \n               data[i + match_len] == data[pos + match_len]):\n            match_len += 1\n        \n        if match_len > best_len:\n            best_len = match_len\n            best_dist = pos - i - 1  # distance is 0-indexed from current position\n    \n    return best_len, best_dist\n\ndata = open('data.txt', 'rb').read()\nencoder = ArithmeticEncoder()\n\nencoder.put_integer(len(data), 9, 0)\nprint(f\"After length: {len(encoder.output)}\")\n\npos = 0\nmax_dist = (1 << 5) - 1  # OFF1 = 5 bits, so max distance = 31\nmax_backref_len = (1 << 2)  # OFF2 = 2 bits, gives 0-3, then +1, so 1-4\n\nwhile pos < len(data):\n    # Try to find a match\n    match_len, match_dist = find_best_match(data, pos, max_dist, max_backref_len + 1)\n    \n    # Only use backreference if it's worth it\n    if match_len >= 2:\n        # Use backreference\n        encoder.put_bit(1, 1)\n        encoder.put_integer(match_dist, 5, 2)  # OFF1 = 5\n        encoder.put_integer(match_len - 1, 2, 3)  # OFF2 = 2, then +1\n        pos += match_len\n    else:\n        # Use literal\n        encoder.put_bit(0, 1)\n        byte_val = data[pos]\n        if byte_val >= 0:\n            encoder.put_bit(0, 8)\n            magnitude = byte_val\n        else:\n            encoder.put_bit(1, 8)\n            magnitude = -byte_val\n        encoder.put_integer(magnitude, 4, 9)\n        pos += 1\n    \n    if pos % 500 == 0:\n        print(f\"Encoded {pos} bytes, output: {len(encoder.output)}\")\n\ncompressed = encoder.finish()\nprint(f\"Final compressed size: {len(compressed)}\")\n\nwith open('data.comp', 'wb') as f:\n    f.write(compressed)\nPYEOF\n"]
