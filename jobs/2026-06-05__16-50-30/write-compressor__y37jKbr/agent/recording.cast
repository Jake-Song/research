ist)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Look for matches\r\n\u001b[?2004l\r\u001b[?2004h>     for i in range(search_start, pos):\r\n\u001b[?2004l\r\u001b[?2004h>         # How many bytes match?\r\n\u001b[?2004l\r\u001b[?2004h>         match_len = 0\r\n\u001b[?2004l\r\u001b[?2004h>         while (match_len < max_len and \r\n\u001b[?2004l\r\u001b[?2004h>                pos + match_len < len(data) and \r\n\u001b[?2004l\r\u001b[?2004h>                data[i + match_len] == data[pos + match_len]):\r\n\u001b[?2004l\r\u001b[?2004h>             match_len += 1\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         if match_len > best_len:\r\n\u001b[?2004l\r\u001b[?2004h>             best_len = match_len\r\n\u001b[?2004l\r\u001b[?2004h> "]
