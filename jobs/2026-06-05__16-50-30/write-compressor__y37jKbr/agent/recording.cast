[345.064962, "o", "\u001b[?2004h> int LITSIZE = 4;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> void put_byte(int b) {\r\n\u001b[?2004l\r\u001b[?2004h>     output_buffer[output_pos++] = b & 0xFF;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> void put_bit(int bit, int ctx) {\r\n\u001b[?2004l\r\u001b[?2004h>     // Make sure we output a byte when needed\r\n\u001b[?2004l\r\u001b[?2004h>     if (range < radix) {\r\n\u001b[?2004l\r\u001b[?2004h>         range *= radix;\r\n\u001b[?2004l\r\u001b[?2004h>         fraction *= radix;\r\n\u001b[?2004l\r\u001b[?2004h>         // We'll handle byte output differently\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     int *counts = cc + ctx * 2;\r\n\u001b[?2004l\r\u001b[?2004h>     int split = range * (counts[0] + 1) / (counts[0] + counts[1] + 2);\r\n\u001b[?2004l\r\u001b[?2004h>     int the_bit = bit;\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     if (the_bit) {\r\n\u001b[?2004l\r\u001b[?2004h>         fraction += split;\r\n\u001b[?2004l\r\u001b[?2004h>         range -= split;\r\n\u001b[?2004l\r\u001b[?2004h>     } else {\r\n\u001b[?2004l\r\u001b[?2004h>         range = split;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     counts[the_bit]++;\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[345.065075, "o", "\u001b[?2004h> "]
