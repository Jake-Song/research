[52.228967, "i", "python3 << 'PYEOF'\nimport io\nimport sys\n\nclass BitWriter:\n    def __init__(self):\n        self.bits = []\n    \n    def write_bit(self, bit):\n        self.bits.append(1 if bit else 0)\n    \n    def write_bits(self, value, count):\n        for i in range(count-1, -1, -1):\n            self.write_bit((value >> i) & 1)\n    \n    def get_bytes(self):\n        # Pad to byte boundary\n        while len(self.bits) % 8:\n            self.bits.append(0)\n        result = bytearray()\n        for i in range(0, len(self.bits), 8):\n            byte = 0\n            for j in range(8):\n                byte = (byte << 1) | self.bits[i+j]\n            result.append(byte)\n        return bytes(result)\n\ndef compress_data(data):\n    writer = BitWriter()\n    \n    # Write length as 9-bit integer using get_integer format\n    # get_integer(9, 0) reads until it finds a 0 bit, then reads 9 bits\n    length = len(data)\n    # For length 4868, we need to encode it\n    # The decompressor reads bits until finding 0, then reads that many bits\n    # Let's use a simpler approach: encode length directly\n    \n    # First, write length-1 in binary after a marker\n    # The get_integer function: subtract_it = 1<<9 = 512\n    # It reads bits until !get_bit, then reads 9 more bits\n    # result = (bits read as binary) + 512\n    # So to encode 4868: we need 4868 - 512 = 4356\n    # 4356 in binary is 10000100010100, needs 13 bits\n    \n    # Actually, let me trace through the decompressor more carefully\n    # get_integer(9, ctx):\n    #   subtract_it = 1<<9 = 512\n    #   result = 1\n    #   while (!get_bit(++tmp+ctx));  // reads bits until 0\n    #   tmp--;\n    #   for i in range(tmp): result = result*2 | get_bit(ctx)\n    #   return result - 512\n    \n    # This means: read bits until we get 0, that tells us how many more bits to read\n    # Then read that many bits as the value\n    \n    # For length=4868:\n    # We need result = 4868, so the inner bits should encode 4868\n    # If tmp ends up being some value, we read tmp bits\n    # and interpret them as: result = read_bits + 1 (from the loop)\n    # Let me just encode it step by step\n    \n    length_to_encode = length  # 4868\n    \n    # Use binary representation of 4868 = 0b1001100000100\n    # Count bits needed\n    bits_needed = length_to_encode.bit_length()  # 13 bits for 4868\n    \n    # Write unary code for bits_needed: write bits_needed 1s then a 0\n    for _ in range(bits_needed):\n        writer.write_bit(1)\n    writer.write_bit(0)\n    \n    # Write the bits_needed bits of the number (minus 1)\n    writer.write_bits(length_to_encode - 1, bits_needed)\n    \n    # Now encode the data\n    # For now, let's use a simple approach: all literals\n    i = 0\n    while i < len(data):\n        # Write control bit: 0 = literal\n        writer.write_bit(0)\n        \n        # Write sign bit (for now, always positive)\n        writer.write_bit(0)\n        \n        # Write 4-bit magnitude (LITSIZE=4, so value 0-15)\n        byte_val = data[i]\n        if byte_val > 127:\n            byte_val = 256 - byte_val\n        writer.write_bits(byte_val, 4)\n        \n        i += 1\n    \n    return writer.get_bytes()\n\nwith open('data.txt', 'rb') as f:\n    data = f.read()\n\ncompressed = compress_data(data)\nprint(f\"Compressed size: {len(compressed)}\")\n\nwith open('data.comp', 'wb') as f:\n    f.write(compressed)\n\nprint(\"Written to data.comp\")\nPYEOF\n"]
