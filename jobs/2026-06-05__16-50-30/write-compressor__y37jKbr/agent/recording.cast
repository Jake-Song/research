[188.220683, "o", "            self.range *= self.radix\r\n\u001b[?2004l\r\u001b[?2004h>         return bytes(self.output)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> data = open('data.txt', 'rb').read()\r\n\u001b[?2004l\r\u001b[?2004h> encoder = ArithmeticEncoder()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Encode length\r\n\u001b[?2004l\r\u001b[?2004h> encoder.put_integer(len(data), 9, 0)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"After length, output size: {len(encoder.output)}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Encode data - all literals for now\r\n\u001b[?2004l\r\u001b[?2004h> for i, byte_val in enumerate(data):\r\n\u001b[?2004l\r\u001b[?2004h>     # Control bit: 0 = literal\r\n\u001b[?2004l\r\u001b[?2004h>     encoder.put_bit(0, 1)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Sign bit and magnitude  \r\n\u001b[?2004l\r\u001b[?2004h>     if byte_val <= 127:\r\n\u001b[?2004l\r\u001b[?2004h>         encoder.put_bit(0, 8)\r\n\u001b[?2004l\r\u001b[?2004h>         val = byte_val\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         encoder.put_bit(1, 8)\r\n\u001b[?2004l\r\u001b[?2004h>         val = 256 - byte_val\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
