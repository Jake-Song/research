[209.006854, "o", "Value: 4868\r\nTarget: 5380\r\nTarget binary: 0b1010100000100\r\nBit length: 13\r\nAfter unary, tmp: 12\r\nBits to read: 010100000100\r\n  After bit 1: result = 2\r\n  After bit 2: result = 5\r\n  After bit 3: result = 10\r\n  After bit 4: result = 21\r\n  After bit 5: result = 42\r\n  After bit 6: result = 84\r\n  After bit 7: result = 168\r\n  After bit 8: result = 336\r\n  After bit 9: result = 672\r\n  After bit 10: result = 1345\r\n  After bit 11: result = 2690\r\n  After bit 12: result = 5380\r\nFinal value: 4868\r\n"]
