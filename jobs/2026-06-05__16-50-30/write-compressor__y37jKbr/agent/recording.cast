[325.201522, "o", "    // For the string \"Hi\" (2 bytes)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[325.202119, "o", "    // Length = 2, so target = 2 + 512 = 514\r\n\u001b[?2004l\r\u001b[?2004h>     // 514 = 0b1000000010, needs 10 bits\r\n\u001b[?2004l\r\u001b[?2004h> "]
[325.202211, "o", "    // So unary: 10 ones then a 0, then 9 bits of 514 without leading 1\r\n\u001b[?2004l\r\u001b[?2004h"]
