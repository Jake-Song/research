[130.801923, "o", "\u001b[?2004h> FILE*f;\r\n\u001b[?2004l\r\u001b[?2004h> void rd(void*p,int sz){(void)fread(p,1,sz,f);}\r\n\u001b[?2004l\r\u001b[?2004h> int tok(char*st,int*ct){\r\n\u001b[?2004l\r\u001b[?2004h> int best=-1,blen=0;\r\n\u001b[?2004l\r\u001b[?2004h> for(int i=0;i<tc;i++){\r\n\u001b[?2004l\r\u001b[?2004h> int tl=strlen(t[i]);\r\n\u001b[?2004l\r\u001b[?2004h> if(tl>0&&tl<=strlen(st)&&!strncmp(t[i],st,tl)&&tl>blen){best=i;blen=tl;}\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> if(best>=0)*ct=blen;\r\n\u001b[?2004l\r\u001b[?2004h> return best>=0?best:0;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> int main(int c,char**v){\r\n\u001b[?2004l\r\u001b[?2004h> if(c<4)return 1;\r\n\u001b[?2004l\r\u001b[?2004h> FILE*q=fopen(v[2],\"r\");\r\n\u001b[?2004l\r\u001b[?2004h> fgets(ln,512,q);\r\n\u001b[?2004l\r\u001b[?2004h> while(fgets(ln,512,q)&&tc<V){\r\n\u001b[?2004l\r\u001b[?2004h> ln[strcspn(ln,\"\\n\")]=0;\r\n\u001b[?2004l\r\u001b[?2004h> t[tc]=strdup(ln);\r\n\u001b[?2004l\r\u001b[?2004h> tc++;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> fclose(q);\r\n\u001b[?2004l\r\u001b[?2004h> f=fopen(v[1],\"rb\");\r\n\u001b[?2004l\r\u001b[?2004h> rd(e,V*D*4);\r\n\u001b[?2004l\r\u001b[?2004h> rd(buf,V*D*4);\r\n\u001b[?2004l\r\u001b[?2004h> printf(\"%s\",v[3]);\r\n\u001b[?2004l\r\u001b[?2004h> fflush(stdout);\r\n\u001b[?2004l\r\u001b[?2004h> strcpy(in,v[3]);\r\n\u001b[?2004l\r\u001b[?2004h> "]
