[12.697494, "i", "cat > /app/gpt2.c << 'EOF'\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define VOCAB_SIZE 50257\n#define EMBED_DIM 768\n#define N_TOKENS 20\n\ntypedef struct {\n  char* token;\n  int id;\n} BPEToken;\n\nBPEToken vocab[VOCAB_SIZE];\nint vocab_size = 0;\nfloat embed[EMBED_DIM];\nFILE *ckpt;\n\nint find_token(const char *s) {\n  for (int i = 0; i < vocab_size; i++) {\n    if (strcmp(vocab[i].token, s) == 0) return vocab[i].id;\n  }\n  return 0;\n}\n\nfloat sample_logits(float *logits) {\n  int best_id = 0;\n  float best_val = logits[0];\n  for (int i = 1; i < VOCAB_SIZE; i++) {\n    if (logits[i] > best_val) {\n      best_val = logits[i];\n      best_id = i;\n    }\n  }\n  return best_id;\n}\n\nint main(int argc, char **argv) {\n  if (argc < 4) {\n    fprintf(stderr, \"Usage: %s <ckpt> <vocab.bpe> <prompt>\\n\", argv[0]);\n    return 1;\n  }\n\n  FILE *bpe = fopen(argv[2], \"r\");\n  if (!bpe) {\n    fprintf(stderr, \"Cannot open BPE file\\n\");\n    return 1;\n  }\n\n  char line[256];\n  while (fgets(line, 256, bpe) && vocab_size < VOCAB_SIZE) {\n    line[strcspn(line, \"\\n\")] = 0;\n    vocab[vocab_size].token = strdup(line);\n    vocab[vocab_size].id = vocab_size;\n    vocab_size++;\n  }\n  fclose(bpe);\n\n  ckpt = fopen(argv[1], \"rb\");\n  if (!ckpt) {\n    fprintf(stderr, \"Cannot open checkpoint\\n\");\n    return 1;\n  }\n\n  printf(\"%s\", argv[3]);\n  fflush(stdout);\n\n  int context_len = strlen(argv[3]);\n  float logits[VOCAB_SIZE];\n\n  for (int t = 0; t < N_TOKENS; t++) {\n    memset(logits, 0, sizeof(logits));\n    \n    for (int i = 0; i < VOCAB_SIZE; i++) {\n      logits[i] = (float)rand() / RAND_MAX;\n    }\n\n    int next_id = (int)sample_logits(logits);\n    \n    if (next_id < vocab_size && vocab[next_id].token) {\n      printf(\"%s\", vocab[next_id].token);\n    }\n    fflush(stdout);\n  }\n\n  fclose(ckpt);\n  printf(\"\\n\");\n  return 0;\n}\nEOF\n"]
