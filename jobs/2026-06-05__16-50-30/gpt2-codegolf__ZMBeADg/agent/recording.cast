[21.273851, "o", "#define D 768\r\n\u001b[?2004l\r\u001b[?2004h> #define T 20\r\n\u001b[?2004l\r\u001b[?2004h> float w[D*D],x[D],y[D],l[V],*b;\r\n\u001b[?2004l\r\u001b[?2004h> char*t[V],ln[999];\r\n\u001b[?2004l\r\u001b[?2004h> int v=0,n;\r\n\u001b[?2004l\r\u001b[?2004h> FILE*f;\r\n\u001b[?2004l\r\u001b[?2004h> void rd(void*p,int s){fread(p,1,s,f);}\r\n\u001b[?2004l\r\u001b[?2004h> void dot(float*a,float*b,float*c,int d){\r\n\u001b[?2004l\r\u001b[?2004h> for(int i=0;i<d;i++){c[i]=0;for(int j=0;j<d;j++)c[i]+=a[i*d+j]*b[j];}}\r\n\u001b[?2004l\r\u001b[?2004h> void sm(float*a,int s){\r\n\u001b[?2004l\r\u001b[?2004h> float m=a[0],z=0;for(int i=0;i<s;i++)if(a[i]>m)m=a[i];\r\n\u001b[?2004l\r\u001b[?2004h> for(int i=0;i<s;i++){a[i]=exp(a[i]-m);z+=a[i];}\r\n\u001b[?2004l\r\u001b[?2004h> for(int i=0;i<s;i++)a[i]/=z;}\r\n\u001b[?2004l\r\u001b[?2004h> int main(int c,char**v){\r\n\u001b[?2004l\r\u001b[?2004h> if(c<4)return 1;\r\n\u001b[?2004l\r\u001b[?2004h> FILE*q=fopen(v[2],\"r\");\r\n\u001b[?2004l\r\u001b[?2004h> while(fgets(ln,999,q)&&v<V){\r\n\u001b[?2004l\r\u001b[?2004h> ln[strcspn(ln,\"\\n\")]=0;\r\n\u001b[?2004l\r\u001b[?2004h> t[v]=strdup(ln);\r\n\u001b[?2004l\r\u001b[?2004h> v++;}\r\n\u001b[?2004l\r\u001b[?2004h> fclose(q);\r\n\u001b[?2004l\r\u001b[?2004h> f=fopen(v[1],\"rb\");\r\n\u001b[?2004l\r\u001b[?2004h> char h[4];\r\n\u001b[?2004l\r\u001b[?2004h> rd(h,4);\r\n\u001b[?2004l\r\u001b[?2004h> int sz;\r\n\u001b[?2004l\r\u001b[?2004h> rd(&sz,4);\r\n\u001b[?2004l\r\u001b[?2004h> b=malloc(sz);\r\n\u001b[?2004l\r\u001b[?2004h> rd(b,sz);\r\n\u001b[?2004l\r\u001b[?2004h> for(int i=0;i<D;i++)x[i]=0;\r\n\u001b[?2004l\r\u001b[?2004h> printf(\"%s\",v[3]);\r\n\u001b[?2004l\r\u001b[?2004h> fflush(stdout);\r\n\u001b[?2004l\r\u001b[?2004h> for(int k=0;k<T;k++){\r\n\u001b[?2004l\r\u001b[?2004h> for(int i=0;i<V;i++)l[i]=0;\r\n\u001b[?2004l\r\u001b[?2004h> int mx=0;\r\n\u001b[?2004l\r\u001b[?2004h> for(int i=1;i<V;i++)if(l[i]>l[mx])mx=i;\r\n\u001b[?2004l\r\u001b[?2004h> if(mx<v&&t[mx])printf(\"%s\",t[mx]);\r\n\u001b[?2004l\r\u001b[?2004h> fflush(stdout);}\r\n\u001b[?2004l\r\u001b[?2004h> fclose(f);\r\n\u001b[?2004l\r\u001b[?2004h> printf(\"\\n\");\r\n\u001b[?2004l\r\u001b[?2004h> return 0;}\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
