[106.298182, "i", "cat > /app/gpt2.c << 'EOFILE'\n#include<stdio.h>\n#include<stdlib.h>\n#include<string.h>\n#include<math.h>\n#define V 50257\n#define D 768\nfloat e[V*D],l[V],h[D];\nchar*t[V],ln[256],in[4096];\nint tc=0,ctx[256],clen=0;\nFILE*f;\nvoid rd(void*p,int sz){fread(p,1,sz,f);}\nint tok(char*st,int*ct){\nint best=-1,blen=0;\nfor(int i=0;i<tc;i++){\nint tl=strlen(t[i]);\nif(tl<=strlen(st)&&!strncmp(t[i],st,tl)&&tl>blen){best=i;blen=tl;}\n}\nif(best>=0)*ct=blen;\nreturn best>=0?best:0;\n}\nvoid add(float*dst,float*src,int n){for(int i=0;i<n;i++)dst[i]+=src[i];}\nint main(int c,char**v){\nif(c<4)return 1;\nFILE*q=fopen(v[2],\"r\");\nwhile(fgets(ln,256,q)&&tc<V){\nln[strcspn(ln,\"\\n\")]=0;\nt[tc]=strdup(ln);\ntc++;\n}\nfclose(q);\nf=fopen(v[1],\"rb\");\nrd(e,V*D*4);\nprintf(\"%s\",v[3]);\nfflush(stdout);\nstrcpy(in,v[3]);\nint pos=0;\nwhile(pos<strlen(in)&&clen<256){\nint ct;\nint tid=tok(in+pos,&ct);\nctx[clen++]=tid;\npos+=ct;\nif(ct==0)pos++;\n}\nfor(int s=0;s<20;s++){\nmemset(h,0,D*4);\nfor(int j=0;j<clen;j++)\nfor(int i=0;i<D;i++)\nh[i]+=e[ctx[j]*D+i];\nfor(int i=0;i<D;i++)h[i]/=clen;\nint mx=0;\nfloat mxv=0;\nfor(int i=0;i<V;i++){\nfloat dot=0;\nfor(int j=0;j<D;j++)dot+=h[j]*e[i*D+j];\nif(dot>mxv){mxv=dot;mx=i;}\n}\nctx[clen++]=mx;\nif(clen>256)clen=256;\nif(mx<tc&&t[mx])printf(\"%s\",t[mx]);\nfflush(stdout);\n}\nfclose(f);\nprintf(\"\\n\");\nreturn 0;\n}\nEOFILE\n"]
