[421.417437, "o", "echo && echo '=== Program info ===' && file /app/a.out && echo \"Compiled with: gcc -O3 /app/gpt2.c -lm -o /app/a.out\"\r\n\u001b[?2004l\r\r\n=== Program info ===\r\n"]
[421.417703, "o", "bash: file: command not found\r\n"]
