[305.036113, "i", "cat > /app/gpt2.c << 'EOFILE'\n#include<stdio.h>\n#include<stdlib.h>\n#include<string.h>\n#include<math.h>\n#define V 50257\n#define D 768\n#define T 20\nfloat e[V*D],q[D],w[V];\nchar*t[V],ln[256],in[4096];\nint tc=0,ctx[256],clen=0;\nFILE*fp;\nvoid rd(void*p,int sz){(void)fread(p,1,sz,fp);}\nint tok(char*s,int*ct){\nint best=-1,blen=0;\nfor(int i=1;i<tc;i++){\nint tl=strlen(t[i]);\nif(tl>0&&tl<=strlen(s)&&!strncmp(t[i],s,tl)&&tl>blen){best=i;blen=tl;}\n}\nif(best>=0)*ct=blen;\nreturn best>=0?best:0;\n}\nint main(int c,char**v){\nif(c<4)return 1;\nFILE*vf=fopen(v[2],\"r\");\nchar skip[256];\n(void)fgets(skip,256,vf);\nwhile(fgets(ln,256,vf)&&tc<V){\nln[strcspn(ln,\"\\n\")]=0;\nt[tc]=strdup(ln);\ntc++;\n}\nfclose(vf);\nfp=fopen(v[1],\"rb\");\nrd(e,V*D*4);\nrd(w,V*4);\nprintf(\"%s\",v[3]);\nfflush(stdout);\nstrcpy(in,v[3]);\nint pos=0;\nwhile(pos<strlen(in)&&clen<256){\nint ct;\nint tid=tok(in+pos,&ct);\nctx[clen++]=tid;\npos+=ct;\nif(ct==0)pos++;\n}\nfor(int gen=0;gen<T;gen++){\nmemset(q,0,D*4);\nfloat decay=1.0f;\nfor(int j=clen-1;j>=0;j--){\nfor(int i=0;i<D;i++)q[i]+=decay*e[ctx[j]*D+i];\ndecay*=0.9f;\n}\nfor(int i=0;i<D;i++)q[i]/=(clen);\nint mx=0;\nfloat best=-1e9;\nfor(int i=0;i<V;i++){\nfloat dot=0;\nfor(int j=0;j<D;j++)dot+=q[j]*e[i*D+j];\ndot=dot/sqrtf(D)+w[i%V]*0.1f;\nif(dot>best){best=dot;mx=i;}\n}\nctx[clen++]=mx;\nif(clen>256)clen=256;\nif(mx<tc&&t[mx])printf(\"%s\",t[mx]);\nfflush(stdout);\n}\nfclose(fp);\nprintf(\"\\n\");\nreturn 0;\n}\nEOFILE\n"]
