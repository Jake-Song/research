[30.75575, "o", "C[i*n+j]=0;for(int p=0;p<k;p++)C[i*n+j]+=A[i*k+p]*B[p*n+j];}}\r\n\u001b[?2004l\r\u001b[?2004h> void gelu(float*a,int n){for(int i=0;i<n;i++)a[i]=0.5*a[i]*(1+tanh(0.797885*a[i]*(1+0.044715*a[i]*a[i])));}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[30.758603, "o", "int main(int c,char**v){\r\n\u001b[?2004l\r\u001b[?2004h> if(c<4)return 1;\r\n\u001b[?2004l\r\u001b[?2004h> FILE*q=fopen(v[2],\"r\");\r\n\u001b[?2004l\r\u001b[?2004h> while(fgets(ln,256,q)&&vc<V){ln[strcspn(ln,\"\\n\")]=0;t[vc]=strdup(ln);vc++;}\r\n\u001b[?2004l\r\u001b[?2004h> fclose(q);\r\n\u001b[?2004l\r\u001b[?2004h> f=fopen(v[1],\"rb\");\r\n\u001b[?2004l\r\u001b[?2004h> e=malloc(V*D*4);w=malloc(D*D*4);b=malloc(D*4);h=malloc(D*4);\r\n\u001b[?2004l\r\u001b[?2004h> int m=rdi(),n=rdi();\r\n\u001b[?2004l\r\u001b[?2004h> for(int i=0;i<V*D;i++)e[i]=rdf();\r\n\u001b[?2004l\r\u001b[?2004h> for(int i=0;i<D*D;i++)w[i]=rdf();\r\n\u001b[?2004l\r\u001b[?2004h> for(int i=0;i<D;i++)b[i]=rdf();\r\n\u001b[?2004l\r\u001b[?2004h> printf(\"%s\",v[3]);\r\n\u001b[?2004l\r\u001b[?2004h> fflush(stdout);\r\n\u001b[?2004l\r\u001b[?2004h> for(int s=0;s<N;s++){\r\n\u001b[?2004l\r\u001b[?2004h> for(int i=0;i<V;i++)l[i]=0;\r\n\u001b[?2004l\r\u001b[?2004h> for(int i=0;i<D;i++)z[i]=e[i]+b[i];\r\n\u001b[?2004l\r\u001b[?2004h> gemm(w,z,h,D,D,1);\r\n\u001b[?2004l\r\u001b[?2004h> for(int i=0;i<V;i++)l[i]=h[i%D];\r\n\u001b[?2004l\r\u001b[?2004h> int mx=0;\r\n\u001b[?2004l\r\u001b[?2004h> for(int i=1;i<V;i++)if(l[i]>l[mx])mx=i;\r\n\u001b[?2004l\r\u001b[?2004h> if(mx<vc)printf(\"%s\",t[mx]);\r\n\u001b[?2004l\r\u001b[?2004h> fflush(stdout);}\r\n\u001b[?2004l\r\u001b[?2004h> fclose(f);printf(\"\\n\");return 0;}\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
