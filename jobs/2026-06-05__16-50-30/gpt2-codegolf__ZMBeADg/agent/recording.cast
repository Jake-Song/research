[117.551624, "i", "python3 << 'PYSCRIPT'\nimport numpy as np\nwith open('/app/gpt2-124M.ckpt', 'rb') as f:\n    data = np.fromfile(f, dtype=np.float32)\n    print(f\"Total floats: {len(data)}\")\n    print(f\"First 10 values: {data[:10]}\")\n    print(f\"Min: {data.min()}, Max: {data.max()}, Mean: {data.mean()}\")\n    \n    V = 50257\n    D = 768\n    embed = data[:V*D].reshape(V, D)\n    print(f\"\\nEmbedding shape: {embed.shape}\")\n    print(f\"First embedding (token 0): {embed[0, :10]}\")\n    print(f\"Token 50256 (last) first 10 dims: {embed[-1, :10]}\")\nPYSCRIPT\n"]
