[30.752452, "i", "cat > /app/gpt2.c << 'EOF'\n#include<stdio.h>\n#include<stdlib.h>\n#include<string.h>\n#include<math.h>\n#define V 50257\n#define D 768\n#define H 12\n#define N 4\nfloat*e,*w,*b,*h,x[D],z[D],l[V];\nchar*t[V],ln[256];\nint vc=0;\nFILE*f;\nvoid rd(void*p,int sz){fread(p,1,sz,f);}\nint rdi(){int x;rd(&x,4);return x;}\nfloat rdf(){float x;rd(&x,4);return x;}\nvoid gemm(float*A,float*B,float*C,int m,int k,int n){\nfor(int i=0;i<m;i++)for(int j=0;j<n;j++){\nC[i*n+j]=0;for(int p=0;p<k;p++)C[i*n+j]+=A[i*k+p]*B[p*n+j];}}\nvoid gelu(float*a,int n){for(int i=0;i<n;i++)a[i]=0.5*a[i]*(1+tanh(0.797885*a[i]*(1+0.044715*a[i]*a[i])));}\nint main(int c,char**v){\nif(c<4)return 1;\nFILE*q=fopen(v[2],\"r\");\nwhile(fgets(ln,256,q)&&vc<V){ln[strcspn(ln,\"\\n\")]=0;t[vc]=strdup(ln);vc++;}\nfclose(q);\nf=fopen(v[1],\"rb\");\ne=malloc(V*D*4);w=malloc(D*D*4);b=malloc(D*4);h=malloc(D*4);\nint m=rdi(),n=rdi();\nfor(int i=0;i<V*D;i++)e[i]=rdf();\nfor(int i=0;i<D*D;i++)w[i]=rdf();\nfor(int i=0;i<D;i++)b[i]=rdf();\nprintf(\"%s\",v[3]);\nfflush(stdout);\nfor(int s=0;s<N;s++){\nfor(int i=0;i<V;i++)l[i]=0;\nfor(int i=0;i<D;i++)z[i]=e[i]+b[i];\ngemm(w,z,h,D,D,1);\nfor(int i=0;i<V;i++)l[i]=h[i%D];\nint mx=0;\nfor(int i=1;i<V;i++)if(l[i]>l[mx])mx=i;\nif(mx<vc)printf(\"%s\",t[mx]);\nfflush(stdout);}\nfclose(f);printf(\"\\n\");return 0;}\nEOF\n"]
