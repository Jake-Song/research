[12.701799, "o", "> float embed[EMBED_DIM];\r\n\u001b[?2004l\r\u001b[?2004h> FILE *ckpt;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> int find_token(const char *s) {\r\n\u001b[?2004l\r\u001b[?2004h>   for (int i = 0; i < vocab_size; i++) {\r\n\u001b[?2004l\r\u001b[?2004h>     if (strcmp(vocab[i].token, s) == 0) return vocab[i].id;\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   return 0;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> float sample_logits(float *logits) {\r\n\u001b[?2004l\r\u001b[?2004h>   int best_id = 0;\r\n\u001b[?2004l\r\u001b[?2004h>   float best_val = logits[0];\r\n\u001b[?2004l\r\u001b[?2004h>   for (int i = 1; i < VOCAB_SIZE; i++) {\r\n\u001b[?2004l\r\u001b[?2004h>     if (logits[i] > best_val) {\r\n\u001b[?2004l\r\u001b[?2004h>       best_val = logits[i];\r\n\u001b[?2004l\r\u001b[?2004h>       best_id = i;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   return best_id;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> int main(int argc, char **argv) {\r\n\u001b[?2004l\r\u001b[?2004h>   if (argc < 4) {\r\n\u001b[?2004l\r\u001b[?2004h>     fprintf(stderr, \"Usage: %s <ckpt> <vocab.bpe> <prompt>\\n\", argv[0]);\r\n\u001b[?2004l\r\u001b[?2004h>     return 1;\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   FILE *bpe = fopen(argv[2], \"r\");\r\n\u001b[?2004l\r\u001b[?2004h>   if (!bpe) {\r\n\u001b[?2004l\r\u001b[?2004h>     fprintf(stderr, \"Cannot open BPE file\\n\");\r\n\u001b[?2004l\r\u001b[?2004h>     return 1;\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   char line[256];\r\n\u001b[?2004l\r\u001b[?2004h>   while (fgets(line, 256, bpe) && vocab_size < VOCAB_SIZE) {\r\n\u001b[?2004l\r\u001b[?2004h>     line[strcspn(line, \"\\n\")] = 0;\r\n\u001b[?2004l\r\u001b[?2004h>     vocab[vocab_size].token = strdup(line);\r\n\u001b[?2004l\r\u001b[?2004h>     vocab[vocab_size].id = vocab_size;\r\n\u001b[?2004l\r\u001b[?2004h>     vocab_size++;\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   fclose(bpe);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   ckpt = fopen(argv[1], \"rb\");\r\n\u001b[?2004l\r\u001b[?2004h>   if (!ckpt) {\r\n\u001b[?2004l\r\u001b[?2004h>     fprintf(stderr, \"Cannot open checkpoint\\n\");\r\n\u001b[?2004l\r\u001b[?2004h>     return 1;\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
