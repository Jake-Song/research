[186.094194, "o", "\u001b[?2004h> for(int i=0;i<V;i++){\r\n\u001b[?2004l\r\u001b[?2004h> a[i%256]=expf((a[i%256]-mx)*0.5f);\r\n\u001b[?2004l\r\u001b[?2004h> "]
