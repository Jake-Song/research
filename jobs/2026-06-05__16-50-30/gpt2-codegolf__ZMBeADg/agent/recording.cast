[67.622356, "o", "int tok(char*s){\r\n\u001b[?2004l\r\u001b[?2004h> for(int i=0;i<tc;i++)if(!strcmp(t[i],s))return i;\r\n\u001b[?2004l\r\u001b[?2004h> return 0;}\r\n\u001b[?2004l\r\u001b[?2004h> void norm(float*a,int n){\r\n\u001b[?2004l\r\u001b[?2004h> float s=0;for(int i=0;i<n;i++)s+=a[i]*a[i];\r\n\u001b[?2004l\r\u001b[?2004h> s=sqrt(s);for(int i=0;i<n;i++)a[i]/=s;}\r\n\u001b[?2004l\r\u001b[?2004h> int main(int c,char**v){\r\n\u001b[?2004l\r\u001b[?2004h> if(c<4)return 1;\r\n\u001b[?2004l\r\u001b[?2004h> FILE*q=fopen(v[2],\"r\");\r\n\u001b[?2004l\r\u001b[?2004h> while(fgets(ln,512,q)&&tc<V){\r\n\u001b[?2004l\r\u001b[?2004h> ln[strcspn(ln,\"\\n\")]=0;\r\n\u001b[?2004l\r\u001b[?2004h> t[tc]=strdup(ln);\r\n\u001b[?2004l\r\u001b[?2004h> tc++;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> fclose(q);\r\n\u001b[?2004l\r\u001b[?2004h> f=fopen(v[1],\"rb\");\r\n\u001b[?2004l\r\u001b[?2004h> rd(e,V*D*4);\r\n\u001b[?2004l\r\u001b[?2004h> printf(\"%s\",v[3]);\r\n\u001b[?2004l\r\u001b[?2004h> fflush(stdout);\r\n\u001b[?2004l\r\u001b[?2004h> int last=0;\r\n\u001b[?2004l\r\u001b[?2004h> for(int s=0;s<20;s++){\r\n\u001b[?2004l\r\u001b[?2004h> memcpy(x,e+last*D,D*4);\r\n\u001b[?2004l\r\u001b[?2004h> for(int i=0;i<V;i++){\r\n\u001b[?2004l\r\u001b[?2004h> l[i]=0;\r\n\u001b[?2004l\r\u001b[?2004h> for(int j=0;j<D;j++)l[i]+=x[j]*e[i*D+j];\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> int mx=0;\r\n\u001b[?2004l\r\u001b[?2004h> for(int i=1;i<V;i++)if(l[i]>l[mx])mx=i;\r\n\u001b[?2004l\r\u001b[?2004h> last=mx;\r\n\u001b[?2004l\r\u001b[?2004h> if(mx<tc&&t[mx])printf(\"%s\",t[mx]);\r\n\u001b[?2004l\r\u001b[?2004h> fflush(stdout);\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> fclose(f);\r\n\u001b[?2004l\r\u001b[?2004h> printf(\"\\n\");\r\n\u001b[?2004l\r\u001b[?2004h> return 0;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOFILE\r\n\u001b[?2004l\r"]
