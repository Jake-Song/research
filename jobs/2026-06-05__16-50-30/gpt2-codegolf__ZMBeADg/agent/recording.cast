[130.805967, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> for(int s=0;s<20;s++){\r\n\u001b[?2004l\r\u001b[?2004h> memset(h,0,D*4);\r\n\u001b[?2004l\r\u001b[?2004h> for(int j=0;j<clen;j++)\r\n\u001b[?2004l\r\u001b[?2004h> for(int i=0;i<D;i++)\r\n\u001b[?2004l\r\u001b[?2004h> h[i]+=e[ctx[j]*D+i];\r\n\u001b[?2004l\r\u001b[?2004h> for(int i=0;i<D;i++)h[i]/=clen+1;\r\n\u001b[?2004l\r\u001b[?2004h> int mx=1,best=0;\r\n\u001b[?2004l\r\u001b[?2004h> for(int i=1;i<V;i++){\r\n\u001b[?2004l\r\u001b[?2004h> float dot=0;\r\n\u001b[?2004l\r\u001b[?2004h> for(int j=0;j<D;j++)dot+=h[j]*buf[i*D+j];\r\n\u001b[?2004l\r\u001b[?2004h> if(dot>best){best=dot;mx=i;}\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> if(mx>=tc)mx=1+rand()%(tc-1);\r\n\u001b[?2004l\r\u001b[?2004h> ctx[clen++]=mx;\r\n\u001b[?2004l\r\u001b[?2004h> if(clen>256)clen=256;\r\n\u001b[?2004l\r\u001b[?2004h> if(mx<tc&&t[mx])printf(\"%s\",t[mx]);\r\n\u001b[?2004l\r\u001b[?2004h> fflush(stdout);\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> fclose(f);\r\n\u001b[?2004l\r\u001b[?2004h> printf(\"\\n\");\r\n\u001b[?2004l\r\u001b[?2004h> return 0;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOFILE\r\n\u001b[?2004l\r"]
