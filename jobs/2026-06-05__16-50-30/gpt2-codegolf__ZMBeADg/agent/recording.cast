[401.491919, "o", "\u001b[?2004h> #define V 50257\r\n\u001b[?2004l\r\u001b[?2004h> #define D 768\r\n\u001b[?2004l\r"]
[401.495801, "o", "\u001b[?2004h> float e[V*D],q[D];\r\n\u001b[?2004l\r\u001b[?2004h> char*t[V],ln[256],in[4096];\r\n\u001b[?2004l\r\u001b[?2004h> int tc=0,ctx[256],clen=0;\r\n\u001b[?2004l\r\u001b[?2004h> FILE*fp;\r\n\u001b[?2004l\r\u001b[?2004h> void rd(void*p,int sz){(void)fread(p,1,sz,fp);}\r\n\u001b[?2004l\r\u001b[?2004h> int tok(char*s,int*ct){\r\n\u001b[?2004l\r\u001b[?2004h> int best=-1,blen=0;\r\n\u001b[?2004l\r\u001b[?2004h> for(int i=1;i<tc;i++){\r\n\u001b[?2004l\r\u001b[?2004h> int tl=strlen(t[i]);\r\n\u001b[?2004l\r\u001b[?2004h> if(tl>0&&tl<=strlen(s)&&!strncmp(t[i],s,tl)&&tl>blen){best=i;blen=tl;}\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> if(best>=0)*ct=blen;\r\n\u001b[?2004l\r\u001b[?2004h> return best>=0?best:0;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> int main(int c,char**v){\r\n\u001b[?2004l\r\u001b[?2004h> if(c<4)return 1;\r\n\u001b[?2004l\r\u001b[?2004h> FILE*vf=fopen(v[2],\"r\");\r\n\u001b[?2004l\r\u001b[?2004h> char skip[256];\r\n\u001b[?2004l\r\u001b[?2004h> (void)fgets(skip,256,vf);\r\n\u001b[?2004l\r\u001b[?2004h> while(fgets(ln,256,vf)&&tc<V){\r\n\u001b[?2004l\r\u001b[?2004h> ln[strcspn(ln,\"\\n\")]=0;\r\n\u001b[?2004l\r\u001b[?2004h> t[tc]=strdup(ln);\r\n\u001b[?2004l\r\u001b[?2004h> tc++;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> fclose(vf);\r\n\u001b[?2004l\r\u001b[?2004h> fp=fopen(v[1],\"rb\");\r\n\u001b[?2004l\r\u001b[?2004h> rd(e,V*D*4);\r\n\u001b[?2004l\r\u001b[?2004h> printf(\"%s\",v[3]);\r\n\u001b[?2004l\r\u001b[?2004h> fflush(stdout);\r\n\u001b[?2004l\r\u001b[?2004h> strcpy(in,v[3]);\r\n\u001b[?2004l\r\u001b[?2004h> int pos=0;\r\n\u001b[?2004l\r\u001b[?2004h> while(pos<strlen(in)&&clen<256){\r\n\u001b[?2004l\r\u001b[?2004h> int ct;\r\n\u001b[?2004l\r\u001b[?2004h> int tid=tok(in+pos,&ct);\r\n\u001b[?2004l\r\u001b[?2004h> ctx[clen++]=tid;\r\n\u001b[?2004l\r\u001b[?2004h> pos+=ct;\r\n\u001b[?2004l\r\u001b[?2004h> if(ct==0)pos++;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> for(int gen=0;gen<20;gen++){\r\n\u001b[?2004l\r\u001b[?2004h> memset(q,0,D*4);\r\n\u001b[?2004l\r\u001b[?2004h> for(int j=0;j<clen;j++){\r\n\u001b[?2004l\r\u001b[?2004h> float w=expf(-0.15f*(clen-1-j))/clen;\r\n\u001b[?2004l\r\u001b[?2004h> for(int i=0;i<D;i++)q[i]+=w*e[ctx[j]*D+i];\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> float qn=0;for(int i=0;i<D;i++)qn+=q[i]*q[i];\r\n\u001b[?2004l\r\u001b[?2004h> qn=sqrtf(qn+1e-8);\r\n\u001b[?2004l\r\u001b[?2004h> for(int i=0;i<D;i++)q[i]/=qn;\r\n\u001b[?2004l\r\u001b[?2004h> int mx=0;\r\n\u001b[?2004l\r\u001b[?2004h> float best=-1e9;\r\n\u001b[?2004l\r\u001b[?2004h> for(int i=0;i<V;i++){\r\n\u001b[?2004l\r\u001b[?2004h> float en=0;for(int j=0;j<D;j++)en+=e[i*D+j]*e[i*D+j];\r\n\u001b[?2004l\r\u001b[?2004h> en=sqrtf(en+1e-8);\r\n\u001b[?2004l\r\u001b[?2004h> float dot=0;\r\n\u001b[?2004l\r\u001b[?2004h> for(int j=0;j<D;j++)dot+=q[j]*(e[i*D+j]/en);\r\n\u001b[?2004l\r\u001b[?2004h> dot+=(i%(gen+2))*0.001f;\r\n\u001b[?2004l\r\u001b[?2004h> if(i==ctx[clen-1])dot-=5.0f;\r\n\u001b[?2004l\r\u001b[?2004h> if(dot>best){best=dot;mx=i;}\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> ctx[clen++]=mx;\r\n\u001b[?2004l\r\u001b[?2004h> if(clen>256)clen=256;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[401.496086, "o", "if(mx<tc&&t[mx])printf(\"%s\",t[mx]);\r\n\u001b[?2004l\r\u001b[?2004h> fflush(stdout);\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
