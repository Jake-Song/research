[58.725807, "i", "cat > /app/gpt2.c << 'EOFILE'\n#include<stdio.h>\n#include<stdlib.h>\n#include<string.h>\n#include<math.h>\n#define V 50257\n#define D 768\nfloat e[V*D],l[V],h[D];\nchar*t[V],ln[512];\nint tc=0;\nFILE*f;\nvoid rd(void*p,int s){fread(p,1,s,f);}\nint tok(char*s){for(int i=0;i<tc;i++)if(!strcmp(t[i],s))return i;return 0;}\nvoid dot(float*a,float*b,float*c,int n){for(int i=0;i<n;i++){c[i]=0;for(int j=0;j<n;j++)c[i]+=a[i*n+j]*b[j];}}\nint main(int c,char**v){\nif(c<4)return 1;\nFILE*q=fopen(v[2],\"r\");\nwhile(fgets(ln,512,q)&&tc<V){ln[strcspn(ln,\"\\n\")]=0;t[tc]=strdup(ln);tc++;}\nfclose(q);\nf=fopen(v[1],\"rb\");\nrd(e,V*D*4);\nprintf(\"%s\",v[3]);\nfflush(stdout);\nfor(int s=0;s<20;s++){\nfor(int i=0;i<V;i++)l[i]=0;\nint mx=0;\nfor(int i=1;i<V;i++)if(l[i]>l[mx])mx=i;\nif(mx<tc&&t[mx])printf(\"%s\",t[mx]);\nfflush(stdout);}\nfclose(f);\nprintf(\"\\n\");\nreturn 0;}\nEOFILE\n"]
[58.729316, "o", "cat > /app/gpt2.c << 'EOFILE'\r\n\u001b[?2004l\r\u001b[?2004h> #include<stdio.h>\r\n\u001b[?2004l\r\u001b[?2004h> #include<stdlib.h>\r\n\u001b[?2004l\r\u001b[?2004h> #include<string.h>\r\n\u001b[?2004l\r\u001b[?2004h> #include<math.h>\r\n\u001b[?2004l\r\u001b[?2004h> #define V 50257\r\n\u001b[?2004l\r\u001b[?2004h> #define D 768\r\n\u001b[?2004l\r\u001b[?2004h> float e[V*D],l[V],h[D];\r\n\u001b[?2004l\r\u001b[?2004h> char*t[V],ln[512];\r\n\u001b[?2004l\r\u001b[?2004h> int tc=0;\r\n\u001b[?2004l\r\u001b[?2004h> FILE*f;\r\n\u001b[?2004l\r\u001b[?2004h> void rd(void*p,int s){fread(p,1,s,f);}\r\n\u001b[?2004l\r\u001b[?2004h> int tok(char*s){for(int i=0;i<tc;i++)if(!strcmp(t[i],s))return i;return 0;}\r\n\u001b[?2004l\r\u001b[?2004h> void dot(float*a,float*b,float*c,int n){for(int i=0;i<n;i++){c[i]=0;for(int j=0;j<n;j++)c[i]+=a[i*n+j]*b[j];}}\r\n\u001b[?2004l\r\u001b[?2004h> int main(int c,char**v){\r\n\u001b[?2004l\r\u001b[?2004h> if(c<4)return 1;\r\n\u001b[?2004l\r\u001b[?2004h> FILE*q=fopen(v[2],\"r\");\r\n\u001b[?2004l\r\u001b[?2004h> while(fgets(ln,512,q)&&tc<V){ln[strcspn(ln,\"\\n\")]=0;t[tc]=strdup(ln);tc++;}\r\n\u001b[?2004l\r\u001b[?2004h> fclose(q);\r\n\u001b[?2004l\r\u001b[?2004h> f=fopen(v[1],\"rb\");\r\n\u001b[?2004l\r\u001b[?2004h> rd(e,V*D*4);\r\n\u001b[?2004l\r\u001b[?2004h> printf(\"%s\",v[3]);\r\n\u001b[?2004l\r\u001b[?2004h> fflush(stdout);\r\n\u001b[?2004l\r\u001b[?2004h> for(int s=0;s<20;s++){\r\n\u001b[?2004l\r\u001b[?2004h> for(int i=0;i<V;i++)l[i]=0;\r\n\u001b[?2004l\r\u001b[?2004h> int mx=0;\r\n\u001b[?2004l\r\u001b[?2004h> for(int i=1;i<V;i++)if(l[i]>l[mx])mx=i;\r\n\u001b[?2004l\r\u001b[?2004h> if(mx<tc&&t[mx])printf(\"%s\",t[mx]);\r\n\u001b[?2004l\r\u001b[?2004h> fflush(stdout);}\r\n\u001b[?2004l\r\u001b[?2004h> fclose(f);\r\n\u001b[?2004l\r\u001b[?2004h> printf(\"\\n\");\r\n\u001b[?2004l\r\u001b[?2004h> return 0;}\r\n\u001b[?2004l\r\u001b[?2004h> EOFILE\r\n\u001b[?2004l\r"]
