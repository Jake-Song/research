[21.269305, "i", "cat > /app/gpt2.c << 'EOF'\n#include<stdio.h>\n#include<stdlib.h>\n#include<string.h>\n#include<math.h>\n#define V 50257\n#define D 768\n#define T 20\nfloat w[D*D],x[D],y[D],l[V],*b;\nchar*t[V],ln[999];\nint v=0,n;\nFILE*f;\nvoid rd(void*p,int s){fread(p,1,s,f);}\nvoid dot(float*a,float*b,float*c,int d){\nfor(int i=0;i<d;i++){c[i]=0;for(int j=0;j<d;j++)c[i]+=a[i*d+j]*b[j];}}\nvoid sm(float*a,int s){\nfloat m=a[0],z=0;for(int i=0;i<s;i++)if(a[i]>m)m=a[i];\nfor(int i=0;i<s;i++){a[i]=exp(a[i]-m);z+=a[i];}\nfor(int i=0;i<s;i++)a[i]/=z;}\nint main(int c,char**v){\nif(c<4)return 1;\nFILE*q=fopen(v[2],\"r\");\nwhile(fgets(ln,999,q)&&v<V){\nln[strcspn(ln,\"\\n\")]=0;\nt[v]=strdup(ln);\nv++;}\nfclose(q);\nf=fopen(v[1],\"rb\");\nchar h[4];\nrd(h,4);\nint sz;\nrd(&sz,4);\nb=malloc(sz);\nrd(b,sz);\nfor(int i=0;i<D;i++)x[i]=0;\nprintf(\"%s\",v[3]);\nfflush(stdout);\nfor(int k=0;k<T;k++){\nfor(int i=0;i<V;i++)l[i]=0;\nint mx=0;\nfor(int i=1;i<V;i++)if(l[i]>l[mx])mx=i;\nif(mx<v&&t[mx])printf(\"%s\",t[mx]);\nfflush(stdout);}\nfclose(f);\nprintf(\"\\n\");\nreturn 0;}\nEOF\n"]
