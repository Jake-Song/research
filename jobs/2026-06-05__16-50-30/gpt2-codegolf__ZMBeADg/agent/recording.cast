[80.531342, "i", "cat > /app/gpt2.c << 'EOFILE'\n#include<stdio.h>\n#include<stdlib.h>\n#include<string.h>\n#include<math.h>\n#define V 50257\n#define D 768\nfloat e[V*D],w[V*D],l[V],h[D],s[D];\nchar*t[V],ln[512],in[4096];\nint tc=0,ctx[512];\nFILE*f;\nvoid rd(void*p,int sz){fread(p,1,sz,f);}\nint tok(char*st,int*ct){\nint best=-1,blen=0;\nfor(int i=0;i<tc;i++){\nint tl=strlen(t[i]);\nif(tl<=strlen(st)&&!strncmp(t[i],st,tl)&&tl>blen){\nbest=i;blen=tl;\n}\n}\nif(best>=0)*ct=blen;\nreturn best>=0?best:0;\n}\nint main(int c,char**v){\nif(c<4)return 1;\nFILE*q=fopen(v[2],\"r\");\nwhile(fgets(ln,512,q)&&tc<V){ln[strcspn(ln,\"\\n\")]=0;t[tc]=strdup(ln);tc++;}\nfclose(q);\nf=fopen(v[1],\"rb\");\nrd(e,V*D*4);\nrd(w,V*D*4);\nprintf(\"%s\",v[3]);\nfflush(stdout);\nstrcpy(in,v[3]);\nint clen=0,pos=0;\nwhile(pos<strlen(in)&&clen<512){\nint ct;\nctx[clen++]=tok(in+pos,&ct);\npos+=ct;\n}\nfor(int s=0;s<20;s++){\nmemset(h,0,D*4);\nfor(int i=0;i<D;i++){\nfor(int j=0;j<clen;j++)h[i]+=e[ctx[j]*D+i];\nh[i]/=clen;\n}\nfor(int i=0;i<V;i++){\nl[i]=0;\nfor(int j=0;j<D;j++)l[i]+=h[j]*w[i*D+j];\n}\nint mx=0;\nfor(int i=1;i<V;i++)if(l[i]>l[mx])mx=i;\nctx[clen++]=mx;\nif(clen>512)clen=512;\nif(mx<tc&&t[mx])printf(\"%s\",t[mx]);\nfflush(stdout);\n}\nfclose(f);\nprintf(\"\\n\");\nreturn 0;\n}\nEOFILE\n"]
