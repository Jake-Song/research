[94.410145, "i", "python3 << 'PYSCRIPT'\nimport struct\nwith open('/app/gpt2-124M.ckpt', 'rb') as f:\n    data = f.read()\n    print(f\"File size: {len(data)} bytes\")\n    print(f\"File size in floats: {len(data) // 4}\")\n    \n    # GPT-2-124M dimensions\n    V = 50257  # vocab\n    D = 768    # embedding dim\n    n_layers = 12\n    \n    embed_size = V * D * 4  # in bytes\n    print(f\"\\nEmbedding matrix size: {V} x {D} = {V*D} floats = {embed_size} bytes\")\n    print(f\"Total transformer params approx: {V*D + n_layers*D*4*D} floats\")\nPYSCRIPT\n"]
