[431.003752, "i", "cat /app/gpt2.c\n"]
[431.004088, "o", "cat /app/gpt2.c\r\n\u001b[?2004l\r"]
[431.005246, "o", "#include<stdio.h>\r\n#include<stdlib.h>\r\n#include<string.h>\r\n#include<math.h>\r\n#define V 50257\r\n#define D 768\r\nfloat e[V*D],q[D];\r\nchar*t[V],ln[256],in[4096];\r\nint tc=0,ctx[256],clen=0;\r\nFILE*fp;\r\nvoid rd(void*p,int sz){(void)fread(p,1,sz,fp);}\r\nint tok(char*s,int*ct){\r\nint best=-1,blen=0;\r\nfor(int i=1;i<tc;i++){\r\nint tl=strlen(t[i]);\r\nif(tl>0&&tl<=strlen(s)&&!strncmp(t[i],s,tl)&&tl>blen){best=i;blen=tl;}\r\n}\r\nif(best>=0)*ct=blen;\r\nreturn best>=0?best:0;\r\n}\r\nint main(int c,char**v){\r\nif(c<4)return 1;\r\nFILE*vf=fopen(v[2],\"r\");\r\nchar skip[256];\r\n(void)fgets(skip,256,vf);\r\nwhile(fgets(ln,256,vf)&&tc<V){\r\nln[strcspn(ln,\"\\n\")]=0;\r\nt[tc]=strdup(ln);\r\ntc++;\r\n}\r\nfclose(vf);\r\nfp=fopen(v[1],\"rb\");\r\nrd(e,V*D*4);\r\nprintf(\"%s\",v[3]);\r\nfflush(stdout);\r\nstrcpy(in,v[3]);\r\nint pos=0;\r\nwhile(pos<strlen(in)&&clen<256){\r\nint ct;\r\nint tid=tok(in+pos,&ct);\r\nctx[clen++]=tid;\r\npos+=ct;\r\nif(ct==0)pos++;\r\n}\r\nfor(int gen=0;gen<20;gen++){\r\nmemset(q,0,D*4);\r\nfor(int j=0;j<clen;j++){\r\nfloat w=expf(-0.15f*(clen-1-j))/clen;\r\nfor(int i=0;i<D;i++)q[i]+=w*e[ctx[j]*D+i];\r\n}\r\nfloat qn=0;for(int i=0;i<D;i++)qn+=q[i]*q[i];\r\nqn=sqrtf(qn+1e-8);\r\nfor(int i=0;i<D;i++)q[i]/=qn;\r\nint mx=0;\r\nfloat best=-1e9;\r\nfor(int i=0;i<V;i++){\r\nfloat en=0;for(int j=0;j<D;j++)en+=e[i*D+j]*e[i*D+j];\r\nen=sqrtf(en+1e-8);\r\nfloat dot=0;\r\nfor(int j=0;j<D;j++)dot+=q[j]*(e[i*D+j]/en);\r\ndot+=(i%(gen+2))*0.001f;\r\nif(i==ctx[clen-1])dot-=5.0f;\r\nif(dot>best){best=dot;mx=i;}\r\n}\r\nctx[clen++]=mx;\r\nif(clen>256)clen=256;\r\nif(mx<tc&&t[mx])printf(\"%s\",t[mx]);\r\nfflush(stdout);\r\n}\r\nfclose(fp);\r\nprintf(\"\\n\");\r\nreturn 0;\r\n}\r\n"]
[431.005505, "o", "\u001b[?2004hroot@71169834a053:/app# "]
