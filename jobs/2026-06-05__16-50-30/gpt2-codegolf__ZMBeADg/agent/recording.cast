[67.616337, "i", "cat > /app/gpt2.c << 'EOFILE'\n#include<stdio.h>\n#include<stdlib.h>\n#include<string.h>\n#include<math.h>\n#define V 50257\n#define D 768\nfloat e[V*D],l[V],x[D];\nchar*t[V],ln[512];\nint tc=0;\nFILE*f;\nvoid rd(void*p,int s){fread(p,1,s,f);}\nint tok(char*s){\nfor(int i=0;i<tc;i++)if(!strcmp(t[i],s))return i;\nreturn 0;}\nvoid norm(float*a,int n){\nfloat s=0;for(int i=0;i<n;i++)s+=a[i]*a[i];\ns=sqrt(s);for(int i=0;i<n;i++)a[i]/=s;}\nint main(int c,char**v){\nif(c<4)return 1;\nFILE*q=fopen(v[2],\"r\");\nwhile(fgets(ln,512,q)&&tc<V){\nln[strcspn(ln,\"\\n\")]=0;\nt[tc]=strdup(ln);\ntc++;\n}\nfclose(q);\nf=fopen(v[1],\"rb\");\nrd(e,V*D*4);\nprintf(\"%s\",v[3]);\nfflush(stdout);\nint last=0;\nfor(int s=0;s<20;s++){\nmemcpy(x,e+last*D,D*4);\nfor(int i=0;i<V;i++){\nl[i]=0;\nfor(int j=0;j<D;j++)l[i]+=x[j]*e[i*D+j];\n}\nint mx=0;\nfor(int i=1;i<V;i++)if(l[i]>l[mx])mx=i;\nlast=mx;\nif(mx<tc&&t[mx])printf(\"%s\",t[mx]);\nfflush(stdout);\n}\nfclose(f);\nprintf(\"\\n\");\nreturn 0;\n}\nEOFILE\n"]
[67.61681, "o", "cat > /app/gpt2.c << 'EOFILE'\r\n\u001b[?2004l\r"]
