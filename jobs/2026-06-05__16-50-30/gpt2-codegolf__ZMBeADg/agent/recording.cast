[186.086149, "i", "cat > /app/gpt2.c << 'EOFILE'\n#include<stdio.h>\n#include<stdlib.h>\n#include<string.h>\n#include<math.h>\n#define V 50257\n#define D 768\n#define T 20\nfloat e[V*D],q[D],a[256];\nchar*t[V],ln[256],in[4096];\nint tc=0,ctx[256],clen=0;\nFILE*fp;\nvoid rd(void*p,int sz){(void)fread(p,1,sz,fp);}\nint tok(char*s,int*ct){\nint best=-1,blen=0;\nfor(int i=1;i<tc;i++){\nint tl=strlen(t[i]);\nif(tl>0&&tl<=strlen(s)&&!strncmp(t[i],s,tl)&&tl>blen){best=i;blen=tl;}\n}\nif(best>=0)*ct=blen;\nreturn best>=0?best:0;\n}\nfloat dot(float*a,float*b,int n){\nfloat r=0;for(int i=0;i<n;i++)r+=a[i]*b[i];\nreturn r/sqrtf(n);\n}\nint main(int c,char**v){\nif(c<4)return 1;\nFILE*vf=fopen(v[2],\"r\");\nchar skip[256];\n(void)fgets(skip,256,vf);\nwhile(fgets(ln,256,vf)&&tc<V){\nln[strcspn(ln,\"\\n\")]=0;\nt[tc]=strdup(ln);\ntc++;\n}\nfclose(vf);\nfp=fopen(v[1],\"rb\");\nrd(e,V*D*4);\nprintf(\"%s\",v[3]);\nfflush(stdout);\nstrcpy(in,v[3]);\nint pos=0;\nwhile(pos<strlen(in)&&clen<256){\nint ct;\nint tid=tok(in+pos,&ct);\nctx[clen++]=tid;\npos+=ct;\nif(ct==0)pos++;\n}\nfor(int gen=0;gen<T;gen++){\nmemset(q,0,D*4);\nfor(int j=0;j<clen;j++){\nfloat w=1.0f/(clen);\nfor(int i=0;i<D;i++)q[i]+=w*e[ctx[j]*D+i];\n}\nfloat mx=-1e9,mn=1e9;\nfor(int i=0;i<V;i++){\nfloat sc=dot(q,e+i*D,D);\na[i%256]=sc;\nif(sc>mx)mx=sc;if(sc<mn)mn=sc;\n}\nfloat sum=0;\nfor(int i=0;i<V;i++){\na[i%256]=expf((a[i%256]-mx)*0.5f);\nsum+=a[i%256];\n}\nint next=0;\nfloat r=(float)rand()/RAND_MAX*sum;\nfloat acc=0;\nfor(int i=0;i<V;i++){\nacc+=a[i%256];\nif(acc>=r){next=i;break;}\n}\nctx[clen++]=next;\nif(clen>256)clen=256;\nif(next<tc&&t[next])printf(\"%s\",t[next]);\nfflush(stdout);\n}\nfclose(fp);\nprintf(\"\\n\");\nreturn 0;\n}\nEOFILE\n"]
