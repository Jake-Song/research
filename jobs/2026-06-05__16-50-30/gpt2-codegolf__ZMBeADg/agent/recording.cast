[219.868306, "o", "if(c<4)return 1;\r\n\u001b[?2004l\r\u001b[?2004h> FILE*vf=fopen(v[2],\"r\");\r\n\u001b[?2004l\r\u001b[?2004h> char skip[256];\r\n\u001b[?2004l\r\u001b[?2004h> (void)fgets(skip,256,vf);\r\n\u001b[?2004l\r\u001b[?2004h> while(fgets(ln,256,vf)&&tc<V){\r\n\u001b[?2004l\r\u001b[?2004h> ln[strcspn(ln,\"\\n\")]=0;\r\n\u001b[?2004l\r\u001b[?2004h> t[tc]=strdup(ln);\r\n\u001b[?2004l\r\u001b[?2004h> tc++;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> fclose(vf);\r\n\u001b[?2004l\r\u001b[?2004h> fp=fopen(v[1],\"rb\");\r\n\u001b[?2004l\r\u001b[?2004h> rd(e,V*D*4);\r\n\u001b[?2004l\r\u001b[?2004h> printf(\"%s\",v[3]);\r\n\u001b[?2004l\r\u001b[?2004h> fflush(stdout);\r\n\u001b[?2004l\r\u001b[?2004h> strcpy(in,v[3]);\r\n\u001b[?2004l\r\u001b[?2004h> int pos=0;\r\n\u001b[?2004l\r\u001b[?2004h> while(pos<strlen(in)&&clen<256){\r\n\u001b[?2004l\r\u001b[?2004h> int ct;\r\n\u001b[?2004l\r\u001b[?2004h> int tid=tok(in+pos,&ct);\r\n\u001b[?2004l\r\u001b[?2004h> ctx[clen++]=tid;\r\n\u001b[?2004l\r\u001b[?2004h> pos+=ct;\r\n\u001b[?2004l\r\u001b[?2004h> if(ct==0)pos++;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> for(int gen=0;gen<T;gen++){\r\n\u001b[?2004l\r\u001b[?2004h> memset(q,0,D*4);\r\n\u001b[?2004l\r\u001b[?2004h> for(int j=0;j<clen;j++){\r\n\u001b[?2004l\r\u001b[?2004h> float w=1.0f/(clen);\r\n\u001b[?2004l\r\u001b[?2004h> for(int i=0;i<D;i++)q[i]+=w*e[ctx[j]*D+i];\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> int mx=0;\r\n\u001b[?2004l\r\u001b[?2004h> float best=-1e9;\r\n\u001b[?2004l\r\u001b[?2004h> for(int i=0;i<V;i++){\r\n\u001b[?2004l\r\u001b[?2004h> float sc=dot(q,e+i*D,D);\r\n\u001b[?2004l\r\u001b[?2004h> if(sc>best){best=sc;mx=i;}\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> ctx[clen++]=mx;\r\n\u001b[?2004l\r\u001b[?2004h> if(clen>256)clen=256;\r\n\u001b[?2004l\r\u001b[?2004h> if(mx<tc&&t[mx])printf(\"%s\",t[mx]);\r\n\u001b[?2004l\r\u001b[?2004h> fflush(stdout);\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> fclose(fp);\r\n\u001b[?2004l\r\u001b[?2004h> printf(\"\\n\");\r\n\u001b[?2004l\r\u001b[?2004h> return 0;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOFILE\r\n\u001b[?2004l\r"]
