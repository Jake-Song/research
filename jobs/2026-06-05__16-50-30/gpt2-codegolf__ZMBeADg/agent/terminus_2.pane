[?2004hroot@71169834a053:/app# cat /app/gpt2.c
[?2004l#include<stdio.h>
#include<stdlib.h>
#include<string.h>
#include<math.h>
#define V 50257
#define D 768
float e[V*D],q[D];
char*t[V],ln[256],in[4096];
int tc=0,ctx[256],clen=0;
FILE*fp;
void rd(void*p,int sz){(void)fread(p,1,sz,fp);}
int tok(char*s,int*ct){
int best=-1,blen=0;
for(int i=1;i<tc;i++){
int tl=strlen(t[i]);
if(tl>0&&tl<=strlen(s)&&!strncmp(t[i],s,tl)&&tl>blen){best=i;blen=tl;}
}
if(best>=0)*ct=blen;
return best>=0?best:0;
}
int main(int c,char**v){
if(c<4)return 1;
FILE*vf=fopen(v[2],"r");
char skip[256];
(void)fgets(skip,256,vf);
while(fgets(ln,256,vf)&&tc<V){
ln[strcspn(ln,"\n")]=0;
t[tc]=strdup(ln);
tc++;
}
fclose(vf);
fp=fopen(v[1],"rb");
rd(e,V*D*4);
printf("%s",v[3]);
fflush(stdout);
strcpy(in,v[3]);
int pos=0;
while(pos<strlen(in)&&clen<256){
int ct;
int tid=tok(in+pos,&ct);
ctx[clen++]=tid;
pos+=ct;
if(ct==0)pos++;
}
for(int gen=0;gen<20;gen++){
memset(q,0,D*4);
for(int j=0;j<clen;j++){
float w=expf(-0.15f*(clen-1-j))/clen;
for(int i=0;i<D;i++)q[i]+=w*e[ctx[j]*D+i];
}
float qn=0;for(int i=0;i<D;i++)qn+=q[i]*q[i];
qn=sqrtf(qn+1e-8);
for(int i=0;i<D;i++)q[i]/=qn;
int mx=0;
float best=-1e9;
for(int i=0;i<V;i++){
float en=0;for(int j=0;j<D;j++)en+=e[i*D+j]*e[i*D+j];
en=sqrtf(en+1e-8);
float dot=0;
for(int j=0;j<D;j++)dot+=q[j]*(e[i*D+j]/en);
dot+=(i%(gen+2))*0.001f;
if(i==ctx[clen-1])dot-=5.0f;
if(dot>best){best=dot;mx=i;}
}
ctx[clen++]=mx;
if(clen>256)clen=256;
if(mx<tc&&t[mx])printf("%s",t[mx]);
fflush(stdout);
}
fclose(fp);
printf("\n");
return 0;
}
