Sending keys: ['cat > /app/optimize_packer_v3.py << \'EOF\'\n#!/usr/bin/env python3\nimport json\nfrom collections import defaultdict\nfrom pathlib import Path\n\ndef align(x: int, g: int) -> int:\n    return ((x + g - 1) // g) * g\n\ndef load_requests(path):\n    reqs = []\n    with open(path, \'r\') as f:\n        for line in f:\n            reqs.append(json.loads(line))\n    return reqs\n\ndef optimize_pack_v3(reqs, granularity=64, max_shapes=8):\n    """\n    Correct strategy: Allow many batches, but limit unique seq_align to 8.\n    Group by (gen_len_range, seq_align) to minimize both prefill and decode padding.\n    """\n    # Calculate aligned seq for each request\n    for r in reqs:\n        r[\'seq_align\'] = align(r[\'prompt_len\'], granularity)\n    \n    # Step 1: Determine which seq_align values to use\n    # Use the max_shapes constraint to select representative seq_align values\n    seq_aligns = sorted(set(r[\'seq_align\'] for r in reqs))\n    print(f"Unique seq_aligns: {len(seq_aligns)}, range: {seq_aligns[0]} - {seq_aligns[-1]}")\n    \n    # Select up to max_shapes representatives\n    if len(seq_aligns) <= max_shapes:\n        representatives = seq_aligns\n    else:\n        # Select evenly spaced representatives\n        step = len(seq_aligns) / max_shapes\n        representatives = sorted(set(\n            seq_aligns[int(i * step)] for i in range(max_shapes)\n        ) | {seq_aligns[-1]})\n    \n    representatives = sorted(representatives)\n    print(f"Selected {len(representatives)} seq_align representatives: {representatives}")\n    \n    # Assign each request to nearest representative (ceiling)\n    def get_representative(s_align):\n        for rep in representatives:\n            if rep >= s_align:\n                return rep\n        return representatives[-1]\n    \n    for r in reqs:\n        r[\'seq_align_rep\'] = get_representative(r[\'seq_align\'])\n    \n    # Step 2: Create batches grouped by (seq_align_rep, gen_len_range)\n    # For each seq_align representative, create multiple small batches by gen_len\n    batches_by_shape = defaultdict(list)\n    \n    for rep in representatives:\n        # Get all requests assigned to this representative\n        reqs_for_rep = [r for r in reqs if r[\'seq_align_rep\'] == rep]\n        \n        # Sort by gen_len\n        reqs_for_rep.sort(key=lambda r: r[\'gen_len\'])\n        \n        # Create small batches to minimize G_max\n        # Target batch size: balance between overhead and padding\n        target_batch_size = max(5, len(reqs_for_rep) // 50)  # Many small batches\n        \n        for i in range(0, len(reqs_for_rep), target_batch_size):\n            batch = reqs_for_rep[i:i+target_batch_size]\n            batches_by_shape[rep].append(batch)\n    \n    # Create plan records\n    plan = []\n    batch_counter = 0\n    \n    for rep in representatives:\n        for batch in batches_by_shape[rep]:\n            batch_id = f"b-{batch_counter:04d}"\n            batch_counter += 1\n            \n            for r in batch:\n                plan.append({\n                    \'request_id\': r[\'request_id\'],\n                    \'batch_id\': batch_id,\n                    \'shape\': {\n                        \'seq_align\': rep,\n                        \'heads_align\': 32,\n                        \'hidden_align\': 4096\n                    }\n                })\n    \n    print(f"Created {batch_counter} batches with {len(representatives)} unique seq_align values")\n    return plan\n\ndef main():\n    root = Path(\'/app/task_file\')\n    \n    print("\\n=== PROCESSING BUCKET 1 ===")\n    reqs1 = load_requests(str(root / \'input_data\' / \'requests_bucket_1.jsonl\'))\n    plan1 = optimize_pack_v3(reqs1)\n    \n    print("\\n=== PROCESSING BUCKET 2 ===")\n    reqs2 = load_requests(str(root / \'input_data\' / \'requests_bucket_2.jsonl\'))\n    plan2 = optimize_pack_v3(reqs2)\n    \n    # Write outputs\n    (root / \'output_data\').mkdir(exist_ok=True)\n