bucket_reqs = gen_buckets[bucket_id]\n        print(f"Bucket {bucket_id}: {len(bucket_reqs)} requests, gen_len range {boundaries[bucket_id]}-{boundaries[bucket_id+1]}")\n        \n        # Sort by seq_align for better grouping\n        bucket_reqs.sort(key=lambda r: r[\'seq_align\'])\n        \n        # Group by seq_align with a max batch size\n        seq_groups = defaultdict(list)\n        for r in bucket_reqs:\n            seq_groups[r[\'seq_align\']].append(r)\n        \n        # Create batches from seq_groups\n        seq_aligns = sorted(seq_groups.keys())\n        for seq_align in seq_aligns:\n            group = seq_groups[seq_align]\n            # Split large groups into multiple batches\n            max_batch_size = max(5, len(bucket_reqs) // 20)  # ~20 batches per gen_bucket\n            for i in range(0, len(group), max_batch_size):\n                all_batches.append(group[i:i+max_batch_size])\n    \n    # Now merge small batches to reduce unique shapes\n    # Sort by size (smallest first) and merge\n    all_batches.sort(key=len)\n    \n    while len(all_batches) > max_shapes:\n        # Merge two smallest batches\n        b1 = all_batches.pop(0)\n        b2 = all_batches.pop(0)\n        merged = b1 + b2\n        # Insert back sorted by size\n        all_batches.append(merged)\n        all_batches.sort(key=len)\n    \n    print(f"Final number of batches: {len(all_batches)}")\n    \n    # Create plan records\n    plan = []\n    for batch_idx, batch in enumerate(all_batches):\n        batch_id = f"b-{batch_idx:04d}"\n        # Get shape for this batch (max seq_align)\n        max_seq = max(r[\'seq_align\'] for r in batch)\n        max_gen = max(r[\'gen_len\'] for r in batch)\n        for r in batch:\n            plan.append({\n                \'request_id\': r[\'request_id\'],\n                \'batch_id\': batch_id,\n                \'shape\': {\n                    \'seq_align\': max_seq,\n                    \'heads_align\': 32,\n                    