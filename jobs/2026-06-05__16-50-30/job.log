Sending keys: ['cat > /app/final_optimizer.py << \'EOF\'\n#!/usr/bin/env python3\nimport json\nfrom collections import defaultdict\nfrom pathlib import Path\nimport sys\nsys.path.insert(0, \'/app/task_file/scripts\')\nfrom cost_model import CostModel, align\n\ndef load_requests(path):\n    reqs = []\n    with open(path, \'r\') as f:\n        for line in f:\n            reqs.append(json.loads(line))\n    return reqs\n\ndef optimize_final(reqs, granularity=64, max_shapes=8):\n    """\n    Final optimization strategy:\n    1. Sort requests by gen_len to minimize G_max variance\n    2. Create batches, each using its own actual max seq_align (no rounding up)\n    3. Track unique seq_aligns used\n    4. If > 8 shapes, compress by merging small batches\n    """\n    # Preprocess\n    for r in reqs:\n        r[\'seq_align\'] = align(r[\'prompt_len\'], granularity)\n    \n    # Sort by gen_len for minimal G_max padding\n    reqs_sorted = sorted(reqs, key=lambda r: r[\'gen_len\'])\n    \n    # Create batches with target size\n    # Start with ~80 batches and compress if needed\n    target_batches = 80\n    batch_size = max(1, len(reqs_sorted) // target_batches)\n    \n    batches = []\n    for i in range(0, len(reqs_sorted), batch_size):\n        batch = reqs_sorted[i:i+batch_size]\n        if batch:\n            batches.append(batch)\n    \n    # Track shapes and merge if necessary\n    unique_shapes = set(max(r[\'seq_align\'] for r in batch) for batch in batches)\n    \n    print(f"Created {len(batches)} batches with {len(unique_shapes)} unique shapes")\n    \n    # If too many shapes, merge small batches\n    while len(unique_shapes) > max_shapes:\n        # Find two batches with smallest combined size\n        batches_by_size = sorted(enumerate(batches), key=lambda x: len(x[1]))\n        idx1, b1 = batches_by_size[0]\n        idx2, b2 = batches_by_size[1]\n        \n        # Merge them (keep in sorted order)\n        merged = sorted(b1 + b2, key=lambda r: r[\'gen_len\'])\n        batches[max(idx1, idx2)] = merged\n        batches.pop(min(idx1, idx2))\n        \n        unique_shapes = set(max(r[\'seq_align\'] for r in batch) for batch in batches)\n        print(f"Merged batches, now {len(batches)} batches with {len(unique_shapes)} shapes")\n    \n    # Create plan using actual seq_align per batch\n    plan = []\n    for batch_idx, batch in enumerate(batches):\n        batch_id = f"b-{batch_idx:04d}"\n        shape = max(r[\'seq_align\'] for r in batch)\n        \n        for r in batch:\n            plan.append({\n                \'request_id\': r[\'request_id\'],\n                \'batch_id\': batch_id,\n                \'shape\': {\n                    \'seq_align\': shape,\n                    \'heads_align\': 32,\n                    \'hidden_align\': 4096\n                }\n            })\n    \n    return plan\n\ndef main():\n    root = Path(\'/app/task_file\')\n    \n    print("\\n=== BUCKET 1 ===")\n    reqs1 = load_requests(str(root / \'input_data\' / \'requests_bucket_1.jsonl\'))\n    plan1 = optimize_final(reqs1)\n    \n    print("\\n=== BUCKET 2 ===")\n    reqs2 = load_requests(str(root / \'input_data\' / \'requests_bucket_2.jsonl\'))\n    plan2 = optimize_final(reqs2)\n    \n    (root / \'output_data\').mkdir(exist_ok=True)\n    \n    with open(root / \'output_data\' / \'plan_b1.jsonl\', \'w\') as f:\n        for record in plan1:\n            f.write(json.dumps(record) + \'\\n\')\n    \n    with open(root / \'output_data\' / \'plan_b2.jsonl\', \'w\') as f:\n        for record in plan2:\n            f.write(json.dumps(record) + \'\\n\')\n    \n    print(f"\\nGenerated {len(plan1)} records in plan_b1.jsonl")\n    print(f"Generated {len(plan2)} records in plan_b2.jsonl")\n\nif __name__ == \'__main__\':\n    main()\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
