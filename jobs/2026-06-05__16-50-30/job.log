Sending keys: ['cat > /app/optimize_2d.py << \'EOF\'\n#!/usr/bin/env python3\nimport json\nfrom pathlib import Path\n\ndef align(x: int, g: int) -> int:\n    return ((x + g - 1) // g) * g\n\ndef load_requests(path):\n    reqs = []\n    with open(path, \'r\') as f:\n        for line in f:\n            reqs.append(json.loads(line))\n    return reqs\n\ndef pack_2d(reqs, target_batches=100):\n    """\n    Sort by (seq_align, gen_len) and create small homogeneous batches.\n    This minimizes both S_max and G_max within each batch.\n    """\n    for r in reqs:\n        r[\'seq_align\'] = align(r[\'prompt_len\'], 64)\n    \n    # Sort by both dimensions\n    reqs_sorted = sorted(reqs, key=lambda r: (r[\'seq_align\'], r[\'gen_len\']))\n    \n    # Create batches\n    batch_size = max(1, len(reqs_sorted) // target_batches)\n    batches = []\n    for i in range(0, len(reqs_sorted), batch_size):\n        batch = reqs_sorted[i:i+batch_size]\n        if batch:\n            batches.append(batch)\n    \n    # Get unique shapes\n    shapes = set(max(r[\'seq_align\'] for r in b) for b in batches)\n    print(f"Created {len(batches)} batches with {len(shapes)} unique shapes")\n    \n    # If too many shapes, need to compress\n    # Map to 8 representatives\n    if len(shapes) > 8:\n        sorted_shapes = sorted(shapes)\n        # Select 8 evenly distributed\n        reps = []\n        for i in range(8):\n            idx = min(len(sorted_shapes)-1, int(i * len(sorted_shapes) / 8))\n            reps.append(sorted_shapes[idx])\n        reps = sorted(set(reps))\n        \n        def get_rep(s):\n            for r in reps:\n                if r >= s:\n                    return r\n            return reps[-1]\n        \n        # Update batches with mapped shapes\n        for batch in batches:\n            for r in batch:\n                r[\'shape_rep\'] = get_rep(r[\'seq_align\'])\n        \n        print(f"Compressed to {len(reps)} shapes: {reps}")\n    else:\n        for batch in batches:\n            for r in batch:\n                r[\'shape_rep\'] = max(r[\'seq_align\'] for r in batch)\n    \n    # Create plan\n    plan = []\n    for batch_idx, batch in enumerate(batches):\n        batch_id = f"b-{batch_idx:04d}"\n        shape = batch[0][\'shape_rep\']\n        for r in batch:\n            plan.append({\n                \'request_id\': r[\'request_id\'],\n                \'batch_id\': batch_id,\n                \'shape\': {\n                    \'seq_align\': shape,\n                    \'heads_align\': 32,\n                    \'hidden_align\': 4096\n                }\n            })\n    \n    return plan\n\ndef main():\n    root = Path(\'/app/task_file\')\n    \n    print("\\n=== BUCKET 1 ===")\n    reqs1 = load_requests(str(root / \'input_data\' / \'requests_bucket_1.jsonl\'))\n    plan1 = pack_2d(reqs1, target_batches=120)\n    \n    print("\\n=== BUCKET 2 ===")\n    reqs2 = load_requests(str(root / \'input_data\' / \'requests_bucket_2.jsonl\'))\n    plan2 = pack_2d(reqs2, target_batches=100)\n    \n    (root / \'output_data\').mkdir(exist_ok=True)\n    \n    with open(root / \'output_data\' / \'plan_b1.jsonl\', \'w\') as f:\n        for record in plan1:\n            f.write(json.dumps(record) + \'\\n\')\n    \n    with open(root / \'output_data\' / \'plan_b2.jsonl\', \'w\') as f:\n        for record in plan2:\n            f.write(json.dumps(record) + \'\\n\')\n\nif __name__ == \'__main__\':\n    main()\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
