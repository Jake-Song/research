Sending keys: ['cat > /app/optimize_packer_final.py << \'EOF\'\n#!/usr/bin/env python3\nimport json\nfrom collections import defaultdict\nfrom pathlib import Path\nimport statistics\n\ndef align(x: int, g: int) -> int:\n    return ((x + g - 1) // g) * g\n\ndef load_requests(path):\n    reqs = []\n    with open(path, \'r\') as f:\n        for line in f:\n            reqs.append(json.loads(line))\n    return reqs\n\ndef optimize_pack_final(reqs, granularity=64, max_shapes=8):\n    """\n    Optimized packing - final version:\n    - Select 8 most frequent seq_align values\n    - Within each shape, divide by gen_len percentiles\n    - Create batches that minimize padding while managing overhead\n    """\n    # Preprocess\n    for r in reqs:\n        r[\'seq_align\'] = align(r[\'prompt_len\'], granularity)\n    \n    # Select top max_shapes seq_aligns by frequency\n    seq_align_counts = defaultdict(int)\n    for r in reqs:\n        seq_align_counts[r[\'seq_align\']] += 1\n    \n    sorted_aligns = sorted(seq_align_counts.items(), key=lambda x: -x[1])\n    selected_aligns = sorted([sa for sa, count in sorted_aligns[:max_shapes]])\n    selected_set = set(selected_aligns)\n    \n    print(f"Selected {len(selected_aligns)} seq_aligns: {selected_aligns}")\n    \n    # Map to nearest representative\n    def get_representative(s_align):\n        if s_align in selected_set:\n            return s_align\n        for sa in selected_aligns:\n            if sa >= s_align:\n                return sa\n        return selected_aligns[-1]\n    \n    for r in reqs:\n        r[\'seq_align_rep\'] = get_representative(r[\'seq_align\'])\n    \n    # For each shape, create buckets by gen_len percentiles\n    all_batches = []\n    \n    for rep in selected_aligns:\n        reqs_for_rep = [r for r in reqs if r[\'seq_align_rep\'] == rep]\n        reqs_for_rep.sort(key=lambda r: r[\'gen_len\'])\n        \n        n_reqs = len(reqs_for_rep)\n        gen_lens = [r[\'gen_len\'] for r in reqs_for_rep]\n        \n        # Determine number of buckets based on gen_len distribution\n        min_gen = min(gen_lens)\n        max_gen = max(gen_lens)\n        median_gen = statistics.median(gen_lens)\n        \n        # Use quartiles for bucketing (4 buckets = 5 percentile points)\n        if n_reqs < 20:\n            num_buckets = 1\n        elif max_gen - min_gen < 100:\n            num_buckets = 2\n        elif max_gen - min_gen < 300:\n            num_buckets = 3\n        elif max_gen - min_gen < 600:\n            num_buckets = 4\n        else:\n            num_buckets = 5\n        \n        # Create buckets\n        bucket_size = (n_reqs + num_buckets - 1) // num_buckets\n        \n        for i in range(0, n_reqs, bucket_size):\n            batch = reqs_for_rep[i:i+bucket_size]\n            if batch:\n                all_batches.append(batch)\n    \n    print(f"Created {len(all_batches)} total batches with {len(selected_aligns)} shapes")\n    \n    # Create plan\n    plan = []\n    for batch_idx, batch in enumerate(all_batches):\n        batch_id = f"b-{batch_idx:04d}"\n        rep = batch[0][\'seq_align_rep\']\n        \n        for r in batch:\n            plan.append({\n                \'request_id\': r[\'request_id\'],\n                \'batch_id\': batch_id,\n                \'shape\': {\n                    \'seq_align\': rep,\n                    \'heads_align\': 32,\n                    \'hidden_align\': 4096\n                }\n            })\n    \n    return plan\n\ndef main():\n    root = Path(\'/app/task_file\')\n    \n    print("\\n=== PROCESSING BUCKET 1 ===")\n    reqs1 = load_requests(str(root / \'input_data\' / \'requests_bucket_1.jsonl\'))\n    plan1 = optimize_pack_final(reqs1)\n    \n    print("\\n=== PROCESSING BUCKET 2 ===")\n    reqs2 = load_requests(str(root / \'input_data\' / \'requests_bucket_2.jsonl\'))\n    plan2 = optimize_pack_final(reqs2)\n    \n    (root / \'output_data\').mkdir(exist_ok=True)\n    \n    with open(root / \'output_data\' / \'plan_b1.jsonl\', \'w\') as f:\n        for record in plan1:\n            f.write(json.dumps(record) + \'\\n\')\n    \n    with open(root / \'output_data\' / \'plan_b2.jsonl\', \'w\') as f:\n        for record in plan2:\n            f.write(json.dumps(record) + \'\\n\')\n    \n    print(f"\\nGenerated {len(plan1)} records in plan_b1.jsonl")\n    print(f"Generated {len(plan2)} records in plan_b2.jsonl")\n\nif __name__ == \'__main__\':\n    main()\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
