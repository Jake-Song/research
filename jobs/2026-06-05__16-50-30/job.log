Sending keys: ['cat > /app/optimize_tuned.py << \'EOF\'\n#!/usr/bin/env python3\nimport json\nfrom collections import defaultdict\nfrom pathlib import Path\nimport sys\nsys.path.insert(0, \'/app/task_file/scripts\')\nfrom cost_model import CostModel, align\n\ndef load_requests(path):\n    reqs = []\n    with open(path, \'r\') as f:\n        for line in f:\n            reqs.append(json.loads(line))\n    return reqs\n\ndef pack_with_batch_count(reqs, target_batches, max_shapes=8):\n    """\n    Create batches sorted by gen_len.\n    """\n    for r in reqs:\n        r[\'seq_align\'] = align(r[\'prompt_len\'], 64)\n    \n    # Find top 8 seq_aligns by frequency\n    seq_align_counts = defaultdict(int)\n    for r in reqs:\n        seq_align_counts[r[\'seq_align\']] += 1\n    sorted_aligns = sorted(seq_align_counts.items(), key=lambda x: -x[1])\n    representatives = sorted([sa for sa, _ in sorted_aligns[:max_shapes]])\n    rep_set = set(representatives)\n    \n    def get_representative(s_align):\n        if s_align in rep_set:\n            return s_align\n        for rep in representatives:\n            if rep >= s_align:\n                return rep\n        return representatives[-1]\n    \n    # Create batches by gen_len\n    reqs_sorted = sorted(reqs, key=lambda r: r[\'gen_len\'])\n    batch_size = max(1, len(reqs_sorted) // target_batches)\n    \n    batches = []\n    for i in range(0, len(reqs_sorted), batch_size):\n        batch = reqs_sorted[i:i+batch_size]\n        if batch:\n            # Assign to representatives\n            for r in batch:\n                r[\'seq_align_rep\'] = get_representative(r[\'seq_align\'])\n            batches.append(batch)\n    \n    # Create plan\n    plan = []\n    for batch_idx, batch in enumerate(batches):\n        batch_id = f"b-{batch_idx:04d}"\n        shape = max(r[\'seq_align_rep\'] for r in batch)\n        for r in batch:\n            plan.append({\n                \'request_id\': r[\'request_id\'],\n                \'batch_id\': batch_id,\n                \'shape\': {\n                    \'seq_align\': shape,\n                    \'heads_align\': 32,\n                    \'hidden_align\': 4096\n                }\n            })\n    \n    return plan, len(batches)\n\ndef evaluate_plan(req_file, plan):\n    requests = {}\n    with open(req_file) as f:\n        for line in f:\n            r = json.loads(line)\n            requests[r[\'request_id\']] = r\n    \n    cm = CostModel(64)\n    metrics = cm.plan_metrics(requests, plan)\n    return metrics\n\ndef main():\n    root = Path(\'/app/task_file\')\n    req_b1 = str(root / \'input_data\' / \'requests_bucket_1.jsonl\')\n    req_b2 = str(root / \'input_data\' / \'requests_bucket_2.jsonl\')\n    \n    reqs1 = load_requests(req_b1)\n    reqs2 = load_requests(req_b2)\n    \n    # Try different batch counts for B1\n    print("Testing different batch counts for Bucket 1:")\n    print("Batches\\tCost\\t\\tPad_Ratio")\n    best_b1 = None\n    best_b1_cost = float(\'inf\')\n    \n    for target_b in [50, 55, 60, 65]:\n        plan1, actual_b = pack_with_batch_count(reqs1, target_b)\n        m1 = evaluate_plan(req_b1, plan1)\n        print(f"{actual_b}\\t{m1[\'cost\']:.3e}\\t{m1[\'pad_ratio\']:.6f}")\n        if m1[\'cost\'] < best_b1_cost:\n            best_b1_cost = m1[\'cost\']\n            best_b1 = (plan1, actual_b, m1)\n    \n    print("\\nTesting different batch counts for Bucket 2:")\n    print("Batches\\tCost\\t\\tPad_Ratio")\n    best_b2 = None\n    best_b2_cost = float(\'inf\')\n    \n    for target_b in [40, 45, 50, 55]:\n        plan2, actual_b = pack_with_batch_count(reqs2, target_b)\n        m2 = evaluate_plan(req_b2, plan2)\n        print(f"{actual_b}\\t{m2[\'cost\']:.3e}\\t{m2[\'pad_ratio\']:.6f}")\n        if m2[\'cost\'] < best_b2_cost:\n            best_b2_cost = m2[\'cost\']\n            best_b2 = (plan2, actual_b, m2)\n    \n    # Use best configurations\n    final_plan1 = best_b1[0]\n    final_plan2 = best_b2[0]\n    \n    (root / \'output_data\').mkdir(exist_ok=True)\n    with open(root / \'output_data\' / \'plan_b1.jsonl\', \'w\') as f:\n        for record in final_plan1:\n            f.write(json.dumps(record) + \'\\n\')\n    with open(root / \'output_data\' / \'plan_b2.jsonl\', \'w\') as f:\n        for record in final_plan2:\n            f.write(json.dumps(record) + \'\\n\')\n    \n    print(f"\\nSelected B1: {best_b1[1]} batches, Cost {best_b1[2][\'cost\']:.3e}")\n    print(f"Selected B2: {best_b2[1]} batches, Cost {best_b2[2][\'cost\']:.3e}")\n\nif __name__ == \'__main__\':\n    main()\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
