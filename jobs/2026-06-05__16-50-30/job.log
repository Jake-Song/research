chunk_file, \'rb\') as chunk_f:\n                        out_f.write(chunk_f.read())\n        else:\n            # Single chunk file, just copy it\n            shard_idx = file_entry["shard"]\n            chunk_idx = file_entry["chunk"]\n            shard_dir = os.path.join(resharded_dir, f"shard_{shard_idx:06d}")\n            chunk_file = os.path.join(shard_dir, f"file_{chunk_idx:06d}")\n            \n            if not os.path.exists(chunk_file):\n                print(f"Error: Chunk file {chunk_file} not found")\n                sys.exit(1)\n            \n            shutil.copy2(chunk_file, output_file_path)\n    \n    # Remove shard directories and manifest\n    print("Cleaning up shard directories...")\n    shard_idx = 0\n    while True:\n        shard_dir = os.path.join(resharded_dir, f"shard_{shard_idx:06d}")\n        if not os.path.exists(shard_dir):\n            break\n        shutil.rmtree(shard_dir)\n        shard_idx += 1\n    \n    # Remove manifest\n    os.remove(manifest_path)\n    \n    print(f"Decompression complete. Files restored in {resharded_dir}")\n\nif __name__ == "__main__":\n    if len(sys.argv) != 2:\n        print(f"Usage: {sys.argv[0]} <resharded_dir>")\n        sys.exit(1)\n    \n    decompress(sys.argv[1])\nEOFDECOMPRESS\n'] min_timeout_sec: 0.3 max_timeout_sec: 180.0
