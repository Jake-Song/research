Sending keys: ['cat > /app/optimize_packer.py << \'EOF\'\n#!/usr/bin/env python3\nimport json\nimport math\nfrom collections import defaultdict\nfrom pathlib import Path\n\ndef align(x: int, g: int) -> int:\n    return ((x + g - 1) // g) * g\n\ndef load_requests(path):\n    reqs = []\n    with open(path, \'r\') as f:\n        for line in f:\n            reqs.append(json.loads(line))\n    return reqs\n\ndef optimize_pack(reqs, granularity=64, max_shapes=8):\n    """\n    Optimized packing that groups by gen_len first to minimize decode padding.\n    """\n    # Calculate aligned seq for each request\n    for r in reqs:\n        r[\'seq_align\'] = align(r[\'prompt_len\'], granularity)\n    \n    # Strategy: Group by gen_len buckets first, then by seq_align within each bucket\n    # This minimizes G_max padding which is the dominant issue\n    \n    # Find optimal gen_len bucketing\n    gen_lens = sorted(set(r[\'gen_len\'] for r in reqs))\n    \n    # Create gen_len buckets - use natural breaks or adaptive bucketing\n    # We want to minimize the max gap (G_max - individual gen_len) per batch\n    gen_buckets = defaultdict(list)\n    \n    # Simple approach: create buckets based on percentiles\n    # Group requests with similar gen_len together\n    bucket_size = max(1, len(reqs) // (max_shapes * 2))  # Rough estimate\n    \n    # Sort requests by (gen_len, seq_align) for better locality\n    reqs_sorted = sorted(reqs, key=lambda r: (r[\'gen_len\'], r[\'seq_align\']))\n    \n    # Create batches greedily\n    batches = []\n    current_batch = []\n    current_seq_align = None\n    current_gen_len = None\n    max_batch_size = 100  # Reasonable batch size\n    \n    for r in reqs_sorted:\n        seq_align = r[\'seq_align\']\n        gen_len = r[\'gen_len\']\n        \n        # Start new batch if:\n        # 1. Adding this request would significantly increase G_max, OR\n        # 2. Current batch is getting too large\n        should_new_batch = False\n        \n        if