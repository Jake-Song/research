Sending keys: ['cat > /app/optimize_packer_hybrid.py << \'EOF\'\n#!/usr/bin/env python3\nimport json\nfrom collections import defaultdict\nfrom pathlib import Path\n\ndef align(x: int, g: int) -> int:\n    return ((x + g - 1) // g) * g\n\ndef load_requests(path):\n    reqs = []\n    with open(path, \'r\') as f:\n        for line in f:\n            reqs.append(json.loads(line))\n    return reqs\n\ndef optimize_pack_hybrid(reqs, granularity=64, max_shapes=8):\n    """\n    Hybrid approach:\n    1. Sort by gen_len to create batches with low G_max variance\n    2. Select max_shapes most frequent seq_align values globally\n    3. Map each batch\'s requests to nearest representative seq_align\n    """\n    # Preprocess\n    for r in reqs:\n        r[\'seq_align\'] = align(r[\'prompt_len\'], granularity)\n    \n    # Step 1: Find most frequent seq_align values across all requests\n    seq_align_counts = defaultdict(int)\n    for r in reqs:\n        seq_align_counts[r[\'seq_align\']] += 1\n    \n    # Select top max_shapes by frequency\n    sorted_aligns = sorted(seq_align_counts.items(), key=lambda x: -x[1])\n    representatives = sorted([sa for sa, _ in sorted_aligns[:max_shapes]])\n    rep_set = set(representatives)\n    \n    print(f"Selected {len(representatives)} shapes: {representatives}")\n    print(f"Shape frequencies: {sorted_aligns[:max_shapes]}")\n    \n    def get_representative(s_align):\n        if s_align in rep_set:\n            return s_align\n        # Find nearest larger representative\n        for rep in representatives:\n            if rep >= s_align:\n                return rep\n        return representatives[-1]\n    \n    # Step 2: Create batches sorted by gen_len\n    # This minimizes G_max variance within each batch\n    reqs_sorted = sorted(reqs, key=lambda r: r[\'gen_len\'])\n    \n    # Create ~60 batches\n    target_batches = 60\n    batch_size = max(1, len(reqs_sorted) // target_batches)\n    \n    batches = []\n    for i in range(0, len(reqs_sorted), batch_size):\n        batch = reqs_sorted[i:i+batch_size]\n        if batch:\n            batches.append(batch)\n    \n    print(f"Created {len(batches)} batches")\n    \n    # Step 3: For each batch, assign requests to nearest representative seq_align\n    # The batch\'s shape will be the max seq_align_rep in the batch\n    for batch in batches:\n        for r in batch:\n            r[\'seq_align_rep\'] = get_representative(r[\'seq_align\'])\n    \n    # Create plan\n    plan = []\n    for batch_idx, batch in enumerate(batches):\n        batch_id = f"b-{batch_idx:04d}"\n        # Use max representative in batch\n        shape = max(r[\'seq_align_rep\'] for r in batch)\n        \n        for r in batch:\n            plan.append({\n                \'request_id\': r[\'request_id\'],\n                \'batch_id\': batch_id,\n                \'shape\': {\n                    \'seq_align\': shape,\n                    \'heads_align\': 32,\n                    \'hidden_align\': 4096\n                }\n            })\n    \n    return plan\n\ndef main():\n    root = Path(\'/app/task_file\')\n    \n    print("\\n=== PROCESSING BUCKET 1 ===")\n    reqs1 = load_requests(str(root / \'input_data\' / \'requests_bucket_1.jsonl\'))\n    plan1 = optimize_pack_hybrid(reqs1)\n    \n    print("\\n=== PROCESSING BUCKET 2 ===")\n    reqs2 = load_requests(str(root / \'input_data\' / \'requests_bucket_2.jsonl\'))\n    plan2 = optimize_pack_hybrid(reqs2)\n    \n    (root / \'output_data\').mkdir(exist_ok=True)\n    \n    with open(root / \'output_data\' / \'plan_b1.jsonl\', \'w\') as f:\n        for record in plan1:\n            f.write(json.dumps(record) + \'\\n\')\n    \n    with open(root / \'output_data\' / \'plan_b2.jsonl\', \'w\') as f:\n        for record in plan2:\n            f.write(json.dumps(record) + \'\\n\')\n    \n    print(f"\\nGenerated {len(plan1)} records in plan_b1.jsonl")\n    print(f"Generated {len(plan2)} records in plan_b2.jsonl")\n\nif __name__ == \'__main__\':\n    main()\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
