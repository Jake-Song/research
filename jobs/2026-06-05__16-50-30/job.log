Sending keys: ['cat > /app/compress.py << \'EOFCOMPRESS\'\n#!/usr/bin/env python3\nimport os\nimport sys\nimport json\nimport shutil\nfrom pathlib import Path\nfrom typing import Dict, List, Tuple\n\nMAX_FILES_PER_DIR = 30\nMAX_FILE_SIZE = 15 * 1024 * 1024  # 15MB\n\ndef get_all_files(input_dir: str) -> List[Tuple[str, str]]:\n    """Get all files with their relative paths."""\n    files = []\n    input_path = Path(input_dir)\n    for file_path in sorted(input_path.rglob(\'*\')):\n        if file_path.is_file():\n            rel_path = file_path.relative_to(input_path)\n            files.append((str(file_path), str(rel_path)))\n    return files\n\ndef compress(input_dir: str, output_dir: str):\n    """Reshard dataset into nested structure with max 30 items per dir."""\n    input_dir = os.path.abspath(input_dir)\n    output_dir = os.path.abspath(output_dir)\n    \n    if not os.path.exists(input_dir):\n        print(f"Error: Input directory {input_dir} does not exist")\n        sys.exit(1)\n    \n    # Create output directory\n    os.makedirs(output_dir, exist_ok=True)\n    \n    # Get all files\n    files = get_all_files(input_dir)\n    print(f"Found {len(files)} files to reshard")\n    \n    manifest = {"files": [], "total_files": len(files)}\n    shard_idx = 0\n    file_count_in_shard = 0\n    chunk_idx = 0\n    current_shard_dir = None\n    \n    for file_path, rel_path in files:\n        file_size = os.path.getsize(file_path)\n        \n        # Create new shard directory if needed\n        if file_count_in_shard >= MAX_FILES_PER_DIR:\n            shard_idx += 1\n            file_count_in_shard = 0\n            chunk_idx = 0\n        \n        current_shard_dir = os.path.join(output_dir, f"shard_{shard_idx:06d}")\n        os.makedirs(current_shard_dir, exist_ok=True)\n        \n        # Handle file splitting if necessary\n        if file_size <= MAX_FILE_SIZE:\n            # File fits in one chunk\n            output_file = os.path.join(current_shard_dir, f"file_{chunk_idx:06d}")\n            shutil.copy2(file_path, output_file)\n            manifest["files"].append({\n                "original_path": rel_path,\n                "shard": shard_idx,\n                "chunk": chunk_idx,\n                "chunks_total": 1,\n                "size": file_size\n            })\n            chunk_idx += 1\n            file_count_in_shard += 1\n        else:\n            # Need to split file into chunks\n            chunks = []\n            chunk_num = 0\n            with open(file_path, \'rb\') as f:\n                while True:\n                    chunk_data = f.read(MAX_FILE_SIZE)\n                    if not chunk_data:\n                        break\n                    \n                    if file_count_in_shard >= MAX_FILES_PER_DIR:\n                        shard_idx += 1\n                        file_count_in_shard = 0\n                        chunk_idx = 0\n                        current_shard_dir = os.path.join(output_dir, f"shard_{shard_idx:06d}")\n                        os.makedirs(current_shard_dir, exist_ok=True)\n                    \n                    output_file = os.path.join(current_shard_dir, f"file_{chunk_idx:06d}")\n                    with open(output_file, \'wb\') as out_f:\n                        out_f.write(chunk_data)\n                    \n                    chunks.append({\n                        "shard": shard_idx,\n                        "chunk": chunk_idx,\n                        "size": len(chunk_data)\n                    })\n                    chunk_idx += 1\n                    file_count_in_shard += 1\n                    chunk_num += 1\n            \n            manifest["files"].append({\n                "original_path": rel_path,\n                "chunks": chunks,\n                "chunks_total": len(chunks),\n                "size": file_size\n            })\n    \n    # Write manifest\n    manifest_path = os.path.join(output_dir, "manifest.json")\n    with open(manifest_path, \'w\') as f:\n        json.dump(manifest, f, indent=2)\n    \n    print(f"Resharding complete. Output in {output_dir}")\n    print(f"Created {shard_idx + 1} shards")\n    print(f"Manifest saved to {manifest_path}")\n\nif __name__ == "__main__":\n    if len(sys.argv) != 3:\n        print(f"Usage: {sys.argv[0]} <input_dir> <output_dir>")\n        sys.exit(1)\n    \n    compress(sys.argv[1], sys.argv[2])\nEOFCOMPRESS\n'] min_timeout_sec: 0.3 max_timeout_sec: 180.0
