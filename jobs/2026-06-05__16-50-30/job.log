Sending keys: ['cat > /app/optimize_packer_v8.py << \'EOF\'\n#!/usr/bin/env python3\nimport json\nfrom collections import defaultdict\nfrom pathlib import Path\nimport sys\nsys.path.insert(0, \'/app/task_file/scripts\')\nfrom cost_model import CostModel, align\n\ndef load_requests(path):\n    reqs = []\n    with open(path, \'r\') as f:\n        for line in f:\n            reqs.append(json.loads(line))\n    return reqs\n\ndef optimize_pack_v8(reqs, granularity=64, max_shapes=8):\n    """\n    Smarter packing using cost-aware optimization.\n    - Select seq_align representatives\n    - Within each, create batches that minimize cost\n    """\n    # Preprocess\n    for r in reqs:\n        r[\'seq_align\'] = align(r[\'prompt_len\'], granularity)\n    \n    # Select seq_align representatives (use top 8 by request count)\n    seq_align_counts = defaultdict(int)\n    seq_align_reqs = defaultdict(list)\n    for r in reqs:\n        seq_align_counts[r[\'seq_align\']] += 1\n        seq_align_reqs[r[\'seq_align\']].append(r)\n    \n    # Sort by count and select top max_shapes\n    sorted_aligns = sorted(seq_align_counts.items(), key=lambda x: -x[1])\n    representatives = sorted([sa for sa, count in sorted_aligns[:max_shapes]])\n    \n    print(f"Selected {len(representatives)} seq_aligns by frequency")\n    print(f"Counts: {sorted_aligns[:max_shapes]}")\n    \n    # Assign unmapped seq_aligns to nearest representative\n    def get_representative(s_align):\n        for rep in representatives:\n            if rep >= s_align:\n                return rep\n        return representatives[-1]\n    \n    for r in reqs:\n        r[\'seq_align_rep\'] = get_representative(r[\'seq_align\'])\n    \n    # For each representative, create batches using a greedy cost-minimizing strategy\n    cost_model = CostModel(granularity=granularity)\n    all_batches = []\n    \n    for rep in representatives:\n        reqs_for_rep = [r for r in reqs if r[\'seq_align_rep\'] == rep]\n        reqs_for_rep.sort(key=lambda r: r[\'gen_len\'])  # Sort by gen_len\n        \n        # Greedy batching: start with one request, keep adding requests while cost improves\n        batches = []\n        remaining = reqs_for_rep[:]\n        \n        while remaining:\n            current_batch = [remaining.pop(0)]\n            \n            # Try to add more requests to current batch\n            i = 0\n            while i < len(remaining):\n                test_batch = current_batch + [remaining[i]]\n                # Calculate cost of adding this request\n                test_cost = cost_model.batch_metrics(test_batch)[\'cost\']\n                current_cost = cost_model.batch_metrics(current_batch)[\'cost\']\n                batch_overhead_cost = 10_000_000  # From cost_model\n                \n                # Add if cost doesn\'t increase too much (account for batch overhead)\n                if test_cost - current_cost - batch_overhead_cost < batch_overhead_cost * 0.5:\n                    current_batch.append(remaining.pop(i))\n                else:\n                    i += 1\n            \n            batches.append(current_batch)\n        \n        all_batches.extend(batches)\n    \n    print(f"Created {len(all_batches)} total batches")\n    \n    # Create plan\n    plan = []\n    for batch_idx, batch in enumerate(all_batches):\n        batch_id = f"b-{batch_idx:04d}"\n        rep = batch[0][\'seq_align_rep\']\n        \n        for r in batch:\n            plan.append({\n                \'request_id\': r[\'request_id\'],\n                \'batch_id\': batch_id,\n                \'shape\': {\n                    \'seq_align\': rep,\n                    \'heads_align\': 32,\n                    \'hidden_align\': 4096\n                }\n            })\n    \n    return plan\n\ndef main():\n    root = Path(\'/app/task_file\')\n    \n    print("\\n=== PROCESSING BUCKET 1 ===")\n    reqs1 = load_requests(str(root / \'input_data\' / \'requests_bucket_1.jsonl\'))\n    plan1 = optimize_pack_v8(reqs1)\n    \n    print("\\n=== PROCESSING BUCKET 2 ===")\n    reqs2 = load_requests(str(root / \'input_data\' / \'requests_bucket_2.jsonl\'))\n    plan2 = optimize_pack_v8(reqs2)\n    \n    (root / \'output_data\').mkdir(exist_ok=True)\n    \n    with open(root / \'output_data\' / \'plan_b1.jsonl\', \'w\') as f:\n        for record in plan1:\n            f.write(json.dumps(record) + \'\\n\')\n    \n    with open(root / \'output_data\' / \'plan_b2.jsonl\', \'w\') as f:\n        for record in plan2:\n            f.write(json.dumps(record) + \'\\n\')\n    \n    print(f"\\nGenerated {len(plan1)} records in plan_b1.jsonl")\n    print(f"Generated {len(plan2)} records in plan_b2.jsonl")\n\nif __name__ == \'__main__\':\n    main()\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
